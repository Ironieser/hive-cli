#!/usr/bin/env bash
# hive-daemon — background poller daemon for hive-cli
# Writes to ~/.hive/node_monitor.json every 900s.
# PID file: ~/.hive/node_monitor.pid
# Log file: ~/.hive/node_monitor.log  (rolling, last 500 lines)

USER="${USER:-$(whoami)}"
HIVE_DIR="${HIVE_DIR:-${HOME}/.hive}"
DB_DIR="$HIVE_DIR"
DB_FILE="${HIVE_DIR}/node_monitor.json"
DB_TMP="${DB_FILE}.$$.tmp"          # PID-scoped so concurrent writers don't clobber (feedback OPT-C)
DB_LOCK="${DB_FILE}.lock"
PID_FILE="${DB_DIR}/node_monitor.pid"
LOG_FILE="${DB_DIR}/node_monitor.log"
# Cluster-singleton coordination over the shared FS (feedback C5): hostname-tagged
# PID + a heartbeat so any node sees a poller is alive, plus request files for
# cross-node force-repoll / stop (SIGUSR1 only reaches a same-node poller).
NODE_HB="${DB_DIR}/node_monitor.heartbeat"
POLL_REQ="${DB_DIR}/node_monitor.poll-request"
STOP_REQ="${DB_DIR}/node_monitor.stop-request"
HB_EVERY=30                 # write heartbeat roughly every 30s
POLL_INTERVAL=900
_LIBEXEC="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
DBPOST_BIN="${_LIBEXEC}/hive-dbpost"

write_node_heartbeat() { date -Iseconds > "$NODE_HB" 2>/dev/null || true; }

# ── signal handling ───────────────────────────────────────────────────────────
SIGUSR1_RECEIVED=0
trap 'log "Received SIGTERM/SIGINT, exiting."; rm -f "$PID_FILE" "$NODE_HB"; exit 0' TERM INT
trap 'SIGUSR1_RECEIVED=1' USR1

# ── helpers ───────────────────────────────────────────────────────────────────

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
    # Rolling: keep last 500 lines
    local tmp="${LOG_FILE}.tmp"
    tail -n 500 "$LOG_FILE" > "$tmp" && mv "$tmp" "$LOG_FILE"
}

fmt_elapsed_slurm() {
    local t="$1"
    local days=0 hours=0 mins=0 secs=0
    if [[ "$t" == *-* ]]; then
        days="${t%%-*}"; t="${t#*-}"
    fi
    IFS=':' read -ra p <<< "$t"
    if (( ${#p[@]} == 3 )); then
        hours=$(( 10#${p[0]} )); mins=$(( 10#${p[1]} )); secs=$(( 10#${p[2]} ))
    elif (( ${#p[@]} == 2 )); then
        mins=$(( 10#${p[0]} )); secs=$(( 10#${p[1]} ))
    fi
    days=$(( 10#$days ))
    if (( days > 0 )); then
        printf "%dd%dh" "$days" "$hours"
    elif (( hours > 0 )); then
        printf "%dh%dm" "$hours" "$mins"
    else
        printf "%dm" "$mins"
    fi
}

fmt_elapsed_ps() {
    local t="$1"
    local days=0 hours=0 mins=0 secs=0
    if [[ "$t" == *-* ]]; then
        days="${t%%-*}"; t="${t#*-}"
    fi
    IFS=':' read -ra p <<< "$t"
    if (( ${#p[@]} == 3 )); then
        hours=$(( 10#${p[0]} )); mins=$(( 10#${p[1]} )); secs=$(( 10#${p[2]} ))
    elif (( ${#p[@]} == 2 )); then
        mins=$(( 10#${p[0]} )); secs=$(( 10#${p[1]} ))
    fi
    days=$(( 10#$days ))
    if (( days > 0 )); then
        printf "%dd%dh" "$days" "$hours"
    elif (( hours > 0 )); then
        printf "%dh%dm" "$hours" "$mins"
    else
        printf "%dm" "$mins"
    fi
}

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

slurm_time_to_secs() {
    # SLURM TimeLeft (%L): [D-]HH:MM:SS / HH:MM:SS / MM:SS / UNLIMITED / N/A.
    # Emits a JSON token (no quotes): integer seconds, -1 for UNLIMITED, or null.
    local t="$1"
    case "$t" in
        UNLIMITED|unlimited|INFINITE|infinite) printf '%s' '-1'; return ;;
        ''|N/A|n/a|INVALID|NOT_SET)           printf 'null';     return ;;
    esac
    local days=0
    if [[ "$t" == *-* ]]; then days="${t%%-*}"; t="${t#*-}"; fi
    local IFS=':'; local -a p; read -ra p <<< "$t"
    local h=0 m=0 s=0
    if (( ${#p[@]} == 3 )); then
        h=$(( 10#${p[0]:-0} )); m=$(( 10#${p[1]:-0} )); s=$(( 10#${p[2]:-0} ))
    elif (( ${#p[@]} == 2 )); then
        m=$(( 10#${p[0]:-0} )); s=$(( 10#${p[1]:-0} ))
    elif (( ${#p[@]} == 1 )); then
        s=$(( 10#${p[0]:-0} ))
    else
        printf 'null'; return
    fi
    days=$(( 10#${days:-0} ))
    printf '%s' "$(( days*86400 + h*3600 + m*60 + s ))"
}

# ── probe a single job ────────────────────────────────────────────────────────
probe_job() {
    local jobid="$1" node="$2" partition="$3" elapsed_raw="$4" time_left_secs="${5:-null}"
    local outfile="${POLL_TMPDIR}/${jobid}.json"
    local polled_at
    polled_at=$(date -u '+%Y-%m-%dT%H:%M:%S')
    local elapsed_fmt
    elapsed_fmt=$(fmt_elapsed_slurm "$elapsed_raw")

    # Enumerate ALL of the hold-job's GPUs (no --id=0). SLURM cgroup device isolation
    # already scopes nvidia-smi to this job's GPUs (renumbered 0..N-1), so this returns
    # exactly the job's own cards — one line for a 1-GPU job (unchanged), N for a multi-
    # GPU job. compute-apps is deduped by PID (a process spanning >1 GPU is listed once);
    # the /proc/<pid>/cgroup filter still scopes processes to this job. KEEP IN SYNC with
    # hive-poll (the probe body is intentionally duplicated; the parse/post-processing is shared).
    #
    # The GPU query runs in the background under a 60 s deadline (120 half-second ticks — a
    # healthy node was measured at 24 s, wedged ones at 116 s+;
    # HIVE_GPU_QUERY_TICKS overrides it for the offline tests) and reports
    # `GPU_PROBE hung` when the driver never answers (a wedged node blocks nvidia-smi
    # in uninterruptible sleep, so `timeout` cannot end it) — see gpu_query_shell in
    # hive_health.py, which is the scheduler's copy of this. `GPU_PROBE granted=` is
    # the step's CUDA_VISIBLE_DEVICES: non-empty means SLURM gave this job a GPU.
    local probe_cmd
    probe_cmd='MY_JOB=$SLURM_JOB_ID; echo "GPU_PROBE granted=${CUDA_VISIBLE_DEVICES:-}"; _o=; for _d in "${TMPDIR:-}" /tmp /dev/shm; do [ -n "$_d" ] && [ -d "$_d" ] || continue; _t=$(mktemp -p "$_d" hive_probe.XXXXXXXX 2>/dev/null) || continue; if echo x >"$_t" 2>/dev/null && echo x >"$_t.rc" 2>/dev/null; then : >"$_t"; rm -f "$_t.rc"; _o=$_t; break; fi; rm -f "$_t" "$_t.rc"; done; [ -n "$_o" ] || { echo "GPU_PROBE nowrite"; exit 0; }; ( nvidia-smi --query-gpu=index,utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits >"$_o" 2>/dev/null; echo $? >"$_o.rc" ) </dev/null >/dev/null 2>&1 & _i=0; while [ ! -s "$_o.rc" ] && [ "$_i" -lt "${HIVE_GPU_QUERY_TICKS:-120}" ]; do sleep 0.5; _i=$((_i+1)); done; _H=; if [ -s "$_o.rc" ]; then cat "$_o"; else _H=1; echo "GPU_PROBE hung"; fi; rm -f "$_o" "$_o.rc"; echo "---PS---"; [ -n "$_H" ] || nvidia-smi --query-compute-apps=pid,used_gpu_memory --format=csv,noheader,nounits 2>/dev/null | sort -t, -k1,1 -u | while IFS=, read apid amem; do apid="${apid// /}"; amem="${amem// /}"; [[ -z "$apid" || ! "$apid" =~ ^[0-9]+$ ]] && continue; grep -q "/job_${MY_JOB}/" /proc/${apid}/cgroup 2>/dev/null || continue; etime=$(ps -p "$apid" -o etime --no-header 2>/dev/null | tr -d " "); args=$(ps -p "$apid" -o args --no-header 2>/dev/null); echo "$apid 0.0 0.0 ${etime:-0:00} $args"; done'

    # Run probe; retry once on transient failure (empty / non-zero / no ---PS---
    # marker). Distinguishes probe failure from a genuinely idle GPU (feedback OPT-A).
    local raw rc
    raw=$(timeout 150 srun --jobid="$jobid" --overlap -n1 --mem=0 \
        bash -c "$probe_cmd" 2>/dev/null); rc=$?
    if [[ "$raw" != *"GPU_PROBE hung"* && "$raw" != *"GPU_PROBE nowrite"* ]] \
            && [[ $rc -ne 0 || -z "$raw" || "$raw" != *"---PS---"* ]]; then
        sleep 1
        raw=$(timeout 150 srun --jobid="$jobid" --overlap -n1 --mem=0 \
            bash -c "$probe_cmd" 2>/dev/null); rc=$?
    fi
    # probe_detail says WHY a probe failed: gpu_unresponsive / no_gpu_devices are the
    # node's fault (the scheduler strikes it on verify), srun_failed is the step's.
    local probe_failed=0 probe_detail="" gpu_granted=""
    if [[ "$raw" == *"GPU_PROBE nowrite"* ]]; then
        # No writable temp dir on the node: the probe could not run. Not a verdict.
        probe_failed=1; probe_detail="srun_failed"
    elif [[ "$raw" == *"GPU_PROBE hung"* ]]; then
        probe_failed=1; probe_detail="gpu_unresponsive"
    elif [[ $rc -ne 0 || -z "$raw" || "$raw" != *"---PS---"* ]]; then
        probe_failed=1; probe_detail="srun_failed"
    fi
    [[ "$raw" =~ GPU_PROBE\ granted=([^[:space:]]+) ]] && gpu_granted="${BASH_REMATCH[1]}"

    local in_ps=0
    local gpu_json="" ps_json=""
    local first_gpu=1 first_ps=1
    local max_gpu_mem=0 max_gpu_util=0 max_gpu_total=0
    local skip_re='sleep|slurm_script|bash|sh |srun|ps -u|grep|nvidia-smi|tmux|zsh|fish|-bash|-zsh|-fish'

    while IFS= read -r line; do
        if [[ "$line" == "---PS---" ]]; then
            in_ps=1; continue
        fi

        if (( in_ps == 0 )); then
            [[ -z "$line" ]] && continue
            IFS=',' read -r gidx gutil gmem_used gmem_total <<< "$line"
            gidx="${gidx// /}"; gutil="${gutil// /}"
            gmem_used="${gmem_used// /}"; gmem_total="${gmem_total// /}"
            [[ -z "$gidx" || ! "$gidx" =~ ^[0-9]+$ ]] && continue
            [[ "$first_gpu" -eq 0 ]] && gpu_json+=","
            gpu_json+="{\"index\":${gidx},\"util\":${gutil:-0},\"mem_used\":${gmem_used:-0},\"mem_total\":${gmem_total:-0}}"
            first_gpu=0
            (( ${gmem_used:-0}  > max_gpu_mem   )) && max_gpu_mem=${gmem_used:-0}
            (( ${gutil:-0}     > max_gpu_util  )) && max_gpu_util=${gutil:-0}
            (( ${gmem_total:-0} > max_gpu_total )) && max_gpu_total=${gmem_total:-0}
        else
            [[ -z "$line" ]] && continue
            echo "$line" | grep -qE "$skip_re" && continue

            local fields ppid pcpu pmem petime pcmd
            read -ra fields <<< "$line"
            ppid="${fields[0]}"; pcpu="${fields[1]}"; pmem="${fields[2]}"; petime="${fields[3]}"
            pcmd="${fields[*]:4}"

            [[ -z "$ppid" || -z "$pcmd" ]] && continue
            [[ ! "$ppid" =~ ^[0-9]+$ ]] && continue

            local elapsed_ps cmd_esc
            elapsed_ps=$(fmt_elapsed_ps "$petime")
            cmd_esc=$(json_escape "$pcmd")

            [[ "$first_ps" -eq 0 ]] && ps_json+=","
            ps_json+="{\"pid\":${ppid},\"cpu\":${pcpu:-0},\"mem\":${pmem:-0},\"elapsed\":\"${elapsed_ps}\",\"cmd\":\"${cmd_esc}\"}"
            first_ps=0
        fi
    done <<< "$raw"

    local status
    if (( probe_failed )); then
        status="probe_failed"
    elif (( max_gpu_total == 0 )) && [[ -n "$gpu_granted" ]]; then
        # SLURM granted a GPU but nvidia-smi listed none ("No devices were found"):
        # a broken node, not a CPU-only hold job.
        status="probe_failed"; probe_detail="no_gpu_devices"
    elif (( max_gpu_total == 0 )); then
        status="cpu"
    elif (( max_gpu_util >= 5 || max_gpu_mem >= 500 )); then
        status="busy"
    else
        status="idle"
    fi

    cat > "$outfile" <<EOF
"${jobid}": {
  "node": "$(json_escape "$node")",
  "partition": "$(json_escape "$partition")",
  "job_elapsed": "$(json_escape "$elapsed_fmt")",
  "gpu": [${gpu_json}],
  "processes": [${ps_json}],
  "status": "${status}",
  "probe_detail": "${probe_detail}",
  "gpu_idle_since": null,
  "time_left_secs": ${time_left_secs},
  "polled_at": "${polled_at}"
}
EOF
}

# ── one poll cycle ────────────────────────────────────────────────────────────
do_poll() {
    POLL_TMPDIR="/tmp/hive_daemon_$$_$(date +%s)"
    mkdir -p "$DB_DIR" "$POLL_TMPDIR"
    write_node_heartbeat   # refresh liveness at cycle entry (cross-node singleton)

    # Serialize node-DB writers (feedback OPT-C): if a manual `hive poll` or another
    # daemon instance holds the lock, skip this cycle rather than racing the mv.
    exec 9>"$DB_LOCK"
    if ! flock -n 9; then
        log "Node DB locked by another poll — skipping this cycle."
        rm -rf "$POLL_TMPDIR"
        return
    fi
    log "Poll cycle starting"

    # %L = TimeLeft (remaining walltime); %j (job name, last col) is only used to
    # filter cursor_ssh_proxy, then stripped. Order: id|node|part|elapsed|left|name.
    local squeue_out
    squeue_out=$(squeue -u "$USER" -t R --noheader -o "%i|%N|%P|%M|%L|%j" 2>/dev/null \
        | grep -vE '\|(cursor_ssh_proxy|hive_canary)$' \
        | sed 's/|[^|]*$//')   # strip job name column after filtering

    if [[ -z "$squeue_out" ]]; then
        log "No running jobs found."
        local updated
        updated=$(date -u '+%Y-%m-%dT%H:%M:%S')
        printf '{\n  "updated": "%s",\n  "jobs": {}\n}\n' "$updated" > "$DB_TMP"
        mv "$DB_TMP" "$DB_FILE"
        rm -rf "$POLL_TMPDIR"
        exec 9>&-   # release node-DB lock (do not hold it across the sleep)
        log "DB written (empty): $DB_FILE"
        return
    fi

    local job_ids=()
    declare -A JOB_NODE JOB_PART JOB_ELAPSED JOB_TIMELEFT

    # 先把 squeue 结果全部读入数组，避免 while read 的 stdin 被后台 srun 消耗
    local -a squeue_lines=()
    while IFS= read -r line; do
        squeue_lines+=("$line")
    done <<< "$squeue_out"

    for line in "${squeue_lines[@]}"; do
        IFS='|' read -r jobid node partition elapsed timeleft <<< "$line"
        jobid="${jobid// /}"; node="${node// /}"
        partition="${partition// /}"; elapsed="${elapsed// /}"; timeleft="${timeleft// /}"
        [[ -z "$jobid" || -z "$node" || "$node" == "N/A" ]] && continue
        job_ids+=("$jobid")
        JOB_NODE["$jobid"]="$node"
        JOB_PART["$jobid"]="$partition"
        JOB_ELAPSED["$jobid"]="$elapsed"
        JOB_TIMELEFT["$jobid"]="$(slurm_time_to_secs "$timeleft")"
        log "Probing job $jobid on $node ($partition) elapsed=$elapsed left=${timeleft:-?} ..."
        probe_job "$jobid" "$node" "$partition" "$elapsed" "${JOB_TIMELEFT[$jobid]}" </dev/null &
    done

    # Wait up to 35s for all probes
    local waited=0
    while true; do
        local pending=0
        for jid in "${job_ids[@]}"; do
            [[ ! -f "${POLL_TMPDIR}/${jid}.json" ]] && pending=1 && break
        done
        (( pending == 0 )) && break
        sleep 1
        waited=$(( waited + 1 ))
        (( waited >= 35 )) && log "WARNING: timeout waiting for probes after ${waited}s" && break
    done
    wait

    log "All probes complete (waited ${waited}s). Building DB..."

    local updated
    updated=$(date -u '+%Y-%m-%dT%H:%M:%S')

    {
        printf '{\n  "updated": "%s",\n  "jobs": {\n' "$updated"
        local first=1
        for jid in "${job_ids[@]}"; do
            local frag="${POLL_TMPDIR}/${jid}.json"
            # probe 失败时写 fallback 记录（status=unknown）
            if [[ ! -f "$frag" ]]; then
                local polled_at; polled_at=$(date -u '+%Y-%m-%dT%H:%M:%S')
                local elapsed_fmt; elapsed_fmt=$(fmt_elapsed_slurm "${JOB_ELAPSED[$jid]:-0:00}")
                cat > "$frag" <<FBEOF
"${jid}": {
  "node": "$(json_escape "${JOB_NODE[$jid]}")",
  "partition": "$(json_escape "${JOB_PART[$jid]}")",
  "job_elapsed": "$(json_escape "$elapsed_fmt")",
  "gpu": [],
  "processes": [],
  "status": "probe_failed",
  "gpu_idle_since": null,
  "time_left_secs": ${JOB_TIMELEFT[$jid]:-null},
  "polled_at": "${polled_at}"
}
FBEOF
            fi
            (( first == 0 )) && printf ',\n'
            while IFS= read -r fline; do
                printf '    %s\n' "$fline"
            done < "$frag"
            first=0
        done
        printf '  }\n}\n'
    } > "$DB_TMP"

    # Preserve the previous DB so hive-dbpost can apply warning timers and
    # carry-forward last-good state for probe_failed jobs.
    local OLD_DB_CONTENT_FILE="${POLL_TMPDIR}/old_db.json"
    [[ -f "$DB_FILE" ]] && cp "$DB_FILE" "$OLD_DB_CONTENT_FILE" || touch "$OLD_DB_CONTENT_FILE"

    mv "$DB_TMP" "$DB_FILE"

    # Shared post-processing (identical to hive-poll — feedback OPT-A).
    if [[ -x "$DBPOST_BIN" ]]; then
        python3 "$DBPOST_BIN" "$DB_FILE" "$OLD_DB_CONTENT_FILE" 2>/dev/null || true
    fi

    rm -rf "$POLL_TMPDIR"
    exec 9>&-   # release node-DB lock (do not hold it across the sleep)
    log "DB written: $DB_FILE  (${#job_ids[@]} jobs)"
}

# ── main loop ─────────────────────────────────────────────────────────────────
main() {
    mkdir -p "$DB_DIR"

    # Write PID file WITH hostname (mirrors sched.pid) so other nodes can tell where
    # the single poller lives; clear any stale stop-request from a prior instance.
    printf '%s\n%s\n' "$$" "$(hostname)" > "$PID_FILE"
    rm -f "$STOP_REQ"
    write_node_heartbeat
    log "hive-daemon started (PID $$, host $(hostname), interval=${POLL_INTERVAL}s)"

    # Immediate first poll
    do_poll

    while true; do
        # Sleep in 1s increments to catch SIGUSR1 + cross-node request files quickly
        local slept=0
        SIGUSR1_RECEIVED=0
        while (( slept < POLL_INTERVAL )); do
            sleep 1
            slept=$(( slept + 1 ))
            (( slept % HB_EVERY == 0 )) && write_node_heartbeat
            if [[ -f "$STOP_REQ" ]]; then
                log "stop-request file seen — exiting."
                rm -f "$STOP_REQ" "$PID_FILE" "$NODE_HB"
                exit 0
            fi
            if [[ -f "$POLL_REQ" ]]; then
                log "poll-request file seen — triggering immediate poll"
                rm -f "$POLL_REQ"
                break
            fi
            if (( SIGUSR1_RECEIVED )); then
                log "SIGUSR1 received — triggering immediate poll"
                break
            fi
        done
        do_poll
    done
}

main "$@"
