#!/usr/bin/env python3
"""hive-pool — manage the pre-allocated SLURM node pool

Commands:
  hive pool add [PRESET] [--count N] [--exclude NODES]
                                       Submit new hold job(s); quarantined nodes
                                       (hive health) are excluded automatically
  hive pool release JOBID              Cancel a hold job (scancel)
  hive pool release --idle             Cancel all currently IDLE hold jobs
  hive pool init                       Create ~/.hive/pool_config.json from example
  hive pool config                     Show current preset config
"""

import argparse
import json
import os
import re
import shlex
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hive_health as hh   # quarantined nodes are kept out of new hold jobs

# ── Paths ────────────────────────────────────────────────────────────────────
HIVE_DIR     = os.environ.get("HIVE_DIR", os.path.expanduser("~/.hive"))
CONFIG_FILE  = os.path.join(HIVE_DIR, "pool_config.json")
NODE_DB      = os.path.join(HIVE_DIR, "node_monitor.json")
POOL_LOG_DIR = os.path.join(HIVE_DIR, "pool-logs")

LIBEXEC_DIR  = os.path.dirname(os.path.realpath(__file__))
EXAMPLE_FILE = os.path.join(os.path.dirname(LIBEXEC_DIR), "pool_config.example.json")

C_GREEN  = "\033[32m"
C_YELLOW = "\033[33m"
C_RED    = "\033[31m"
C_BOLD   = "\033[1m"
C_DIM    = "\033[2m"
C_RESET  = "\033[0m"


# ── Config helpers ────────────────────────────────────────────────────────────

def load_config():
    if not os.path.exists(CONFIG_FILE):
        print(f"{C_YELLOW}No pool config found.{C_RESET}", file=sys.stderr)
        print(f"Run  {C_BOLD}hive pool init{C_RESET}  to create one, or:", file=sys.stderr)
        print(f"  cp {EXAMPLE_FILE} {CONFIG_FILE}", file=sys.stderr)
        print(f"  # then edit {CONFIG_FILE} for your cluster", file=sys.stderr)
        sys.exit(1)
    try:
        with open(CONFIG_FILE) as f:
            return json.load(f)
    except (json.JSONDecodeError, OSError) as e:
        print(f"Error reading {CONFIG_FILE}: {e}", file=sys.stderr)
        sys.exit(1)


def get_preset(config, name=None):
    presets = config.get("presets", {})
    if not presets:
        print("No presets defined in pool_config.json.", file=sys.stderr)
        sys.exit(1)

    preset_name = name or config.get("default") or next(iter(presets))
    if preset_name not in presets:
        print(f"Preset '{preset_name}' not found. Available: {', '.join(presets)}", file=sys.stderr)
        sys.exit(1)

    return preset_name, presets[preset_name]


# ── Node DB ───────────────────────────────────────────────────────────────────

def load_idle_jobids():
    if not os.path.exists(NODE_DB):
        return []
    try:
        with open(NODE_DB) as f:
            jobs = json.load(f).get("jobs", {})
        return [jid for jid, info in jobs.items() if info.get("status") == "idle"]
    except (json.JSONDecodeError, OSError):
        return []


# ── Node exclusion ────────────────────────────────────────────────────────────

def script_excludes(script):
    """Node lists from the script's own `#SBATCH --exclude=` / `-x` lines. An
    `--exclude` on the sbatch command line REPLACES those rather than adding to them,
    so they have to be carried over by hand."""
    found = []
    try:
        with open(script) as f:
            lines = f.readlines()
    except OSError:
        return found
    for line in lines:
        m = re.match(r"^\s*#SBATCH\s+(.*)$", line)
        if not m:
            continue
        # One #SBATCH line may carry several options, quoted or not:
        #   #SBATCH -p gpu -x evc7      #SBATCH --partition=gpu --exclude="evc8,evc9"
        try:
            words = shlex.split(m.group(1), comments=True)
        except ValueError:
            words = m.group(1).split()
        k = 0
        while k < len(words):
            w = words[k]
            if w.startswith("--exclude="):
                found.append(w[len("--exclude="):])
            elif w in ("--exclude", "-x") and k + 1 < len(words):
                found.append(words[k + 1])
                k += 1
            elif re.fullmatch(r"-x\S+", w) and not w.startswith("--"):
                found.append(w[2:])                  # -xevc7
            k += 1
    return [x for x in found if x]


def build_exclude(script, cli, config_lists, auto):
    """(merged --exclude value or None, quarantined nodes that were added)."""
    flat = []
    for x in config_lists:                      # a string, or a JSON list of them
        flat += [str(y) for y in x] if isinstance(x, (list, tuple)) else ([str(x)] if x else [])
    parts = script_excludes(script) + [x for x in flat if x] + ([cli] if cli else [])
    known = set()
    for p in parts:
        try:
            known.update(hh.expand_nodes(p))
        except ValueError as e:
            print(f"{C_RED}error:{C_RESET} {e}", file=sys.stderr)
            sys.exit(2)
    added = sorted(n for n in hh.quarantined_nodes() - known
                   if hh.valid_node_name(n)) if auto else []
    parts += added
    return (",".join(parts) or None), added


# ── Commands ──────────────────────────────────────────────────────────────────

def cmd_add(args):
    target = args.preset  # may be a preset name or a script path

    # Detect: if it looks like a file path (contains / or ~, or ends in .slurm/.sh), treat as script
    if target and (target.startswith(("~", "/", "./")) or
                   target.endswith((".slurm", ".sh")) or
                   os.path.exists(os.path.expanduser(target))):
        script = os.path.expanduser(target)
        preset_name = os.path.basename(script)
        desc = ""
        # The standing "exclude" of pool_config.json applies to a script path too.
        config_excl = []
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE) as f:
                    config_excl = [json.load(f).get("exclude")]
            except (OSError, json.JSONDecodeError, AttributeError):
                pass
    else:
        config = load_config()
        preset_name, preset = get_preset(config, target)
        script = os.path.expanduser(preset.get("script", ""))
        desc = preset.get("description", "")
        # Standing exclusions: "exclude" at the top of pool_config.json and/or in a preset.
        config_excl = [config.get("exclude"), preset.get("exclude")]
        if not script:
            print(f"Preset '{preset_name}' has no 'script' field.", file=sys.stderr)
            sys.exit(1)

    if not os.path.exists(script):
        print(f"{C_RED}Script not found:{C_RESET} {script}", file=sys.stderr)
        sys.exit(1)

    count = args.count
    time_arg = args.time

    # Redirect hold-job stdout/stderr to $HIVE_DIR/pool-logs/ instead of dumping
    # slurm-<jobid>.out into the submission cwd (feedback SESSION#9). A --output on
    # the sbatch command line overrides any #SBATCH --output in the script.
    os.makedirs(POOL_LOG_DIR, exist_ok=True)
    out_pat = os.path.join(POOL_LOG_DIR, "slurm-%j.out")
    err_pat = os.path.join(POOL_LOG_DIR, "slurm-%j.err")

    # A hold job that lands on a broken node is worse than none: it uses allocation and
    # never runs a task. SLURM favours exactly those nodes — their GPUs are always free —
    # so every node hive has quarantined is excluded unless --no-auto-exclude is given.
    exclude, auto_added = build_exclude(script, args.exclude, config_excl,
                                        not args.no_auto_exclude)

    def build_cmd(extra=None):
        cmd = ["sbatch"]
        if extra:
            cmd += extra
        if time_arg:
            cmd += ["--time", time_arg]
        if exclude and (args.exclude or auto_added or any(config_excl)):
            cmd += [f"--exclude={exclude}"]
        cmd += ["--output", out_pat, "--error", err_pat, script]
        return cmd

    # Validate the script with a dry-run before looping `--count` times, so a bad
    # preset fails once with a clear message instead of N times (feedback OPT-I).
    if not args.no_validate:
        test = subprocess.run(build_cmd(["--test-only"]), capture_output=True, text=True)
        if test.returncode != 0:
            print(f"{C_RED}✗ Preset '{preset_name}' rejected by sbatch --test-only:{C_RESET}",
                  file=sys.stderr)
            print(f"  {test.stderr.strip() or test.stdout.strip()}", file=sys.stderr)
            print(f"  {C_DIM}Fix the script, or bypass with: hive pool add ... --no-validate{C_RESET}",
                  file=sys.stderr)
            sys.exit(1)

    time_str = f"  time={time_arg}" if time_arg else ""
    print(f"Submitting {count}× hold job  [{preset_name}]  {desc}{time_str}")
    print(f"  {C_DIM}logs → {POOL_LOG_DIR}/slurm-<jobid>.out{C_RESET}")
    if auto_added:
        print(f"  {C_DIM}excluding quarantined node(s): {', '.join(auto_added)}  "
              f"(hive health; --no-auto-exclude to skip){C_RESET}")
    requested = [str(x) for x in config_excl + [args.exclude] if x]
    if requested:
        print(f"  {C_DIM}excluding: {', '.join(requested)}{C_RESET}")

    for _ in range(count):
        result = subprocess.run(build_cmd(), capture_output=True, text=True)
        if result.returncode == 0:
            print(f"  {C_GREEN}✓{C_RESET} {result.stdout.strip()}")
            # Remember which exclusions are hive's, so they can be lifted when the
            # node leaves quarantine while this job still waits in the queue.
            m = re.search(r"(\d+)\s*$", result.stdout.strip())
            if m and auto_added:
                try:
                    hh.track_excludes(m.group(1), auto_added)
                except OSError:
                    pass
        else:
            print(f"  {C_RED}✗{C_RESET} {result.stderr.strip()}", file=sys.stderr)


def _confirm_release(targets):
    """Hard authorization gate for releasing (scancel-ing) allocated nodes.

    Releasing is IRREVERSIBLE — the node returns to the SLURM queue and may take a long
    time to re-acquire — so it must always be a deliberate, human-confirmed action:
      * refuses outright in any NON-interactive context (no TTY) — an agent/script can
        never release nodes unattended;
      * otherwise requires the user to type the exact word 'release'.
    There is intentionally NO --yes/--force flag and this must never be blanket-/"always"-
    authorized — every release is confirmed individually.
    """
    desc = ", ".join(targets)
    if not sys.stdin.isatty():
        print(f"{C_RED}Refusing to release nodes: this requires interactive human "
              f"confirmation.{C_RESET}", file=sys.stderr)
        print(f"  Would scancel hold job(s): {desc}", file=sys.stderr)
        print("  `hive pool release` permanently gives back allocated GPU nodes (you re-enter",
              file=sys.stderr)
        print("  the SLURM queue). Run it yourself in a terminal and confirm at the prompt.",
              file=sys.stderr)
        print("  (By design there is no --yes/--force, and it must not be 'always'-allowed.)",
              file=sys.stderr)
        sys.exit(2)
    print(f"{C_YELLOW}⚠  About to RELEASE (scancel) {len(targets)} hold job(s): {desc}{C_RESET}")
    print("   This is IRREVERSIBLE — the node(s) go back to the SLURM queue and you'll have")
    print("   to wait to re-acquire them.")
    try:
        ans = input("   Type 'release' to confirm (anything else aborts): ").strip()
    except (EOFError, KeyboardInterrupt):
        ans = ""
    if ans != "release":
        print("Aborted — nothing released.")
        sys.exit(1)


def cmd_release(args):
    if args.idle:
        idle_ids = load_idle_jobids()
        if not idle_ids:
            print("No IDLE nodes found in node_monitor.json.")
            print("Run 'hive poll' first to refresh node status.")
            return
        _confirm_release(idle_ids)
        print(f"Cancelling {len(idle_ids)} IDLE hold job(s): {', '.join(idle_ids)}")
        for jid in idle_ids:
            result = subprocess.run(["scancel", jid], capture_output=True, text=True)
            if result.returncode == 0:
                print(f"  {C_GREEN}✓{C_RESET} scancel {jid}")
            else:
                print(f"  {C_RED}✗{C_RESET} scancel {jid}: {result.stderr.strip()}")
    else:
        jid = str(args.jobid)
        _confirm_release([jid])
        result = subprocess.run(["scancel", jid], capture_output=True, text=True)
        if result.returncode == 0:
            print(f"{C_GREEN}✓{C_RESET} Cancelled job {jid}")
        else:
            print(f"{C_RED}✗{C_RESET} {result.stderr.strip()}", file=sys.stderr)
            sys.exit(1)


def cmd_init(args):
    if os.path.exists(CONFIG_FILE):
        print(f"Config already exists: {CONFIG_FILE}")
        print("Delete it first if you want to reinitialise.")
        return

    if not os.path.exists(EXAMPLE_FILE):
        print(f"Example file not found: {EXAMPLE_FILE}", file=sys.stderr)
        sys.exit(1)

    os.makedirs(HIVE_DIR, exist_ok=True)
    with open(EXAMPLE_FILE) as f:
        example = f.read()
    with open(CONFIG_FILE, 'w') as f:
        f.write(example)

    print(f"{C_GREEN}✓{C_RESET} Created {CONFIG_FILE}")
    print()
    print(f"Edit it to point to your cluster's sbatch scripts:")
    print(f"  {CONFIG_FILE}")
    print()
    print("Then test with:")
    print(f"  hive pool config    # verify presets look correct")
    print(f"  hive pool add       # submit one hold job")


def cmd_autoscale(args):
    """Show what pool autoscale is set to and what it would do now. It is switched on
    and off in pool_config.json ("autoscale": {"enabled": …}); the scheduler acts on it."""
    import hive_autoscale as hauto
    cfg = hauto.settings()
    state = hauto.load_state()
    if cfg is None:
        print(f"autoscale: {C_DIM}off{C_RESET}  (not enabled in {CONFIG_FILE}, incomplete, "
              f"or past its `until`)")
        print('  to switch it on, add e.g.  "autoscale": {"enabled": true, "preset": "highgpu",')
        print('      "min_nodes": 6, "max_nodes": 8, "time": "7-00:00:00", "renew_before": "12h",')
        print('      "until": "2026-12-31"}')
        return
    print(f"autoscale: {C_GREEN}on{C_RESET}  preset {cfg['preset']}, keep {cfg['min_nodes']} usable, "
          f"at most {cfg['max_nodes']} hold jobs, each {cfg['time'] or 'as in the script'}, "
          f"replaced {int(cfg['renew_before'] // 3600)}h before it expires"
          + (f", until {cfg['until']}" if cfg["until"] else ", with no end date"))
    try:
        with open(NODE_DB) as f:
            db = json.load(f)
        jobs = db.get("jobs", {})
        from datetime import datetime, timezone
        upd = datetime.fromisoformat(db.get("updated")).replace(tzinfo=timezone.utc)
        age = (datetime.now(timezone.utc) - upd).total_seconds()
    except Exception:
        jobs, age = {}, 0
    health = hh.load()
    pending = hh.pending_hold_jobs()
    n, why = hauto.plan(cfg, jobs, age, None if pending is None else len(pending),
                        hh.quarantined_nodes(health) | hh.slow_nodes(health),
                        state.get("submitted") or [])
    print(f"  now: would submit {n} — {why}")
    day = [t for t in (state.get("submitted") or []) if __import__("time").time() - t < 86400]
    print(f"  submitted by autoscale in the last 24 h: {len(day)} (limit {hauto.MAX_PER_DAY})")
    if state.get("last_decision"):
        print(f"  last decision of the scheduler: {state['last_decision']}")


def cmd_config(args):
    config = load_config()
    presets = config.get("presets", {})
    default = config.get("default", "")

    print(f"{C_BOLD}Pool config:{C_RESET}  {CONFIG_FILE}")
    print()
    for name, preset in presets.items():
        marker = f" {C_GREEN}(default){C_RESET}" if name == default else ""
        script = os.path.expanduser(preset.get("script", "(no script)"))
        desc   = preset.get("description", "")
        exists = os.path.exists(script)
        status = f"{C_GREEN}✓{C_RESET}" if exists else f"{C_RED}✗ not found{C_RESET}"
        print(f"  {C_BOLD}{name}{C_RESET}{marker}")
        print(f"    script: {script}  {status}")
        if desc:
            print(f"    desc:   {desc}")
        # Show --time from script if readable
        if exists:
            try:
                with open(script) as f:
                    for line in f:
                        if line.strip().startswith("#SBATCH") and "--time" in line:
                            t = line.split("--time")[1].split()[0].lstrip("=")
                            print(f"    time:   {t}  {C_DIM}(override with --time){C_RESET}")
                            break
            except OSError:
                pass
            # Validate via sbatch --test-only so SLURM-rejected presets surface here
            # (feedback OPT-I) instead of only at submit time.
            if not args.no_validate:
                test = subprocess.run(
                    ["sbatch", "--test-only", script],
                    capture_output=True, text=True)
                if test.returncode == 0:
                    print(f"    valid:  {C_GREEN}✓ sbatch accepts{C_RESET}")
                else:
                    msg = (test.stderr.strip() or test.stdout.strip()).split("\n")[0]
                    print(f"    valid:  {C_RED}✗ {msg}{C_RESET}")


# ── Argument parsing ──────────────────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="hive pool",
        description="Manage the pre-allocated SLURM node pool",
    )
    sub = p.add_subparsers(dest="command", metavar="COMMAND")
    sub.required = True

    # add
    pa = sub.add_parser("add", help="Submit new hold job(s) to expand pool")
    pa.add_argument("preset", nargs="?", default=None,
                    metavar="PRESET|SCRIPT",
                    help="Preset name, or path to a .slurm script (default: from config)")
    pa.add_argument("--count", "-n", type=int, default=1, metavar="N",
                    help="Number of hold jobs to submit (default: 1)")
    pa.add_argument("--time", "-t", default=None, metavar="TIME",
                    help="Override --time in the sbatch script, e.g. 1-00:00:00, 12:00:00, 3d")
    pa.add_argument("--exclude", "-x", default=None, metavar="NODES",
                    help="Nodes the hold job must not land on (SLURM list: evc22,evc[40-43]). "
                         "Added to the script's own #SBATCH --exclude and to the 'exclude' "
                         "key of pool_config.json")
    pa.add_argument("--no-auto-exclude", action="store_true",
                    help="Do not exclude the nodes hive has quarantined (see `hive health`)")
    pa.add_argument("--no-validate", action="store_true",
                    help="Skip the 'sbatch --test-only' pre-flight check")

    # release
    pr = sub.add_parser("release", help="Cancel a hold job (scancel)")
    grp = pr.add_mutually_exclusive_group(required=True)
    grp.add_argument("jobid", nargs="?", type=int, metavar="JOBID",
                     help="SLURM job ID to cancel")
    grp.add_argument("--idle", action="store_true",
                     help="Cancel all currently IDLE hold jobs")

    # init
    sub.add_parser("init", help=f"Create {CONFIG_FILE} from example")

    # autoscale
    sub.add_parser("autoscale", help="Show the autoscale setting and what it would do now")

    # config
    pcfg = sub.add_parser("config", help="Show current preset configuration")
    pcfg.add_argument("--no-validate", action="store_true",
                      help="Skip the per-preset 'sbatch --test-only' check")

    return p


def main():
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "add":
        cmd_add(args)
    elif args.command == "release":
        cmd_release(args)
    elif args.command == "init":
        cmd_init(args)
    elif args.command == "config":
        cmd_config(args)
    elif args.command == "autoscale":
        cmd_autoscale(args)


if __name__ == "__main__":
    main()
