#!/usr/bin/env python3
"""hive-queue — hive task queue CLI

Usage:
  hive queue submit [--workdir DIR] [--priority N] [--name NAME] "CMD"|job.hive
  hive queue list [--state STATE]
  hive queue cancel <id>
  hive queue logs <id> [-f]
  hive queue rm <id>
  hive queue daemon start|stop|status|logs
"""

import argparse
import fcntl
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from datetime import datetime, timedelta

# ── Paths ────────────────────────────────────────────────────────────────────
HIVE_DIR      = os.environ.get("HIVE_DIR", os.path.expanduser("~/.hive"))
QUEUE_FILE    = os.path.join(HIVE_DIR, "queue.json")
QUEUE_LOCK    = os.path.join(HIVE_DIR, "queue.lock")
SCHED_PID     = os.path.join(HIVE_DIR, "sched.pid")
SCHED_LOG     = os.path.join(HIVE_DIR, "sched.log")
SCHED_HB      = os.path.join(HIVE_DIR, "sched.heartbeat")
SCHED_START_LOCK = os.path.join(HIVE_DIR, "sched.start.lock")
LOG_DIR       = os.path.join(HIVE_DIR, "logs")
HEARTBEAT_DIR = os.path.join(HIVE_DIR, "heartbeat")

# GPUs a task sees when it doesn't say. 1, not "whatever the hold job owns",
# because a multi-GPU hold job otherwise makes frameworks auto-parallelize over
# devices the task never asked for (feedback #8). Opt in with `#HIVE gpus=N`.
DEFAULT_TASK_GPUS = 1

LIBEXEC_DIR = os.path.dirname(os.path.realpath(__file__))
SCHED_BIN   = os.path.join(LIBEXEC_DIR, "hive-sched")
PYTHON      = sys.executable  # same interpreter (vlm conda env)

# Shared append-only event log (durable timing/runtime history).
sys.path.insert(0, LIBEXEC_DIR)
import hive_events as ev

HEARTBEAT_DAEMON_TIMEOUT = 90   # 3× poll interval → daemon considered dead


# ── ANSI colors ───────────────────────────────────────────────────────────────
C_RESET  = "\033[0m"
C_BOLD   = "\033[1m"
C_GREEN  = "\033[32m"
C_YELLOW = "\033[33m"
C_RED    = "\033[31m"
C_CYAN   = "\033[36m"
C_DIM    = "\033[2m"

STATE_COLORS = {
    "running":   C_GREEN,
    "pending":   C_YELLOW,
    "done":      C_DIM,
    "failed":    C_RED,
    "cancelled": C_DIM,
}


# ── Queue file helpers (all under flock) ──────────────────────────────────────

class QueueLock:
    def __init__(self):
        self._fd = None

    def __enter__(self):
        os.makedirs(HIVE_DIR, exist_ok=True)
        self._fd = open(QUEUE_LOCK, 'w')
        fcntl.flock(self._fd, fcntl.LOCK_EX)
        return self._fd

    def __exit__(self, *_):
        fcntl.flock(self._fd, fcntl.LOCK_UN)
        self._fd.close()


def load_queue(lfd=None):
    if not os.path.exists(QUEUE_FILE):
        return {"version": 1, "next_id": 1, "tasks": {}}
    try:
        with open(QUEUE_FILE) as f:
            return json.load(f)
    except (json.JSONDecodeError, OSError):
        return {"version": 1, "next_id": 1, "tasks": {}}


def save_queue(data, lfd):
    tmp = QUEUE_FILE + ".tmp"
    with open(tmp, 'w') as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, QUEUE_FILE)


# ── Time helpers ──────────────────────────────────────────────────────────────

def now_iso():
    return datetime.now().strftime('%Y-%m-%dT%H:%M:%S')


def now_ts():
    """Epoch seconds — the tz-independent twin of now_iso(). Written alongside every
    `*_at` string as `*_ts`. Processes touching one queue run under different TZs
    (scheduler, poller, each agent's shell), so arithmetic on the naive `*_at`
    strings was off by hours (feedback #31: RUNNING ELAPSED inflated by 12h)."""
    return time.time()


def parse_iso(s):
    if not s:
        return None
    try:
        return datetime.strptime(s, '%Y-%m-%dT%H:%M:%S')
    except ValueError:
        return None


def task_epoch(task, key):
    """Epoch seconds for a task timestamp (`key` = submitted/started/finished).
    Prefers `<key>_ts`; falls back to the legacy naive-local `<key>_at` string read
    in this process's zone (old records — may be off if written under another TZ)."""
    ts = task.get(f"{key}_ts")
    if isinstance(ts, (int, float)) and not isinstance(ts, bool):
        return float(ts)
    d = parse_iso(task.get(f"{key}_at"))
    return d.timestamp() if d else None


def task_finished_dt(task):
    """Local datetime of a task's finish (tz-safe), for grouping/windowing."""
    e = task_epoch(task, "finished")
    return datetime.fromtimestamp(e) if e is not None else None


def fmt_elapsed(seconds):
    if seconds is None:
        return "—"
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    m, s = divmod(seconds, 60)
    if m < 60:
        return f"{m}m{s:02d}s"
    h, m = divmod(m, 60)
    if h < 24:
        return f"{h}h{m:02d}m"
    d, h = divmod(h, 24)
    return f"{d}d{h:02d}h"


def parse_duration(s):
    """Parse a human runtime estimate into seconds. Accepts:
        '3600' (bare = secs), '45s', '30m', '2h', '1d', '2h30m',
        '12:00:00', '90:00', '1-12:00:00' (SLURM clock).
    Returns int seconds, or None if unparseable."""
    if s is None:
        return None
    s = str(s).strip().lower()
    if not s:
        return None
    if ":" in s:                              # SLURM-style [D-]HH:MM:SS / MM:SS
        days, rest = 0, s
        if "-" in rest:
            d, rest = rest.split("-", 1)
            try:
                days = int(d)
            except ValueError:
                return None
        try:
            parts = [int(p) for p in rest.split(":")]
        except ValueError:
            return None
        if len(parts) == 3:
            h, m, sec = parts
        elif len(parts) == 2:
            h, m, sec = 0, parts[0], parts[1]
        elif len(parts) == 1:
            h, m, sec = 0, 0, parts[0]
        else:
            return None
        return days * 86400 + h * 3600 + m * 60 + sec
    total, matched = 0, False               # unit-suffixed: 2h30m / 90m / 45s / 1d
    for num, unit in re.findall(r'(\d+)\s*([dhms])', s):
        matched = True
        total += int(num) * {"d": 86400, "h": 3600, "m": 60, "s": 1}[unit]
    if matched:
        return total
    if re.fullmatch(r'\d+', s):             # bare integer = seconds
        return int(s)
    return None


def _percentile(sorted_vals, pct):
    if not sorted_vals:
        return None
    if len(sorted_vals) == 1:
        return sorted_vals[0]
    rank = pct / 100.0 * (len(sorted_vals) - 1)
    lo = int(rank)
    hi = min(lo + 1, len(sorted_vals) - 1)
    return int(round(sorted_vals[lo] + (sorted_vals[hi] - sorted_vals[lo]) * (rank - lo)))


def runs_by_name():
    """{name: [run_secs, ...]} merging the durable event log (survives prune) with any
    `done` tasks still in queue.json, deduped by task id (event log preferred)."""
    merged = {}   # task_id -> (name, run_secs)
    try:
        for tid, (nm, rs) in ev.done_runs().items():
            merged[tid] = (nm, rs)
    except Exception:
        pass
    for t in load_queue().get("tasks", {}).values():
        if t.get("state") == "done" and isinstance(t.get("duration_secs"), int) \
                and t["duration_secs"] > 0:
            merged.setdefault(t["id"], (t.get("name") or "", t["duration_secs"]))
    by_name = {}
    for _tid, (nm, rs) in merged.items():
        by_name.setdefault(nm, []).append(rs)
    return by_name


def history_estimate(name):
    """Conservative runtime estimate (secs) for a task name from completed history:
    the p90 of past `done` run durations. Returns (est_secs, sample_n); (None, 0) if no
    history. p90 (not mean) so the estimate covers near-worst-case walltime."""
    if not name:
        return None, 0
    durs = sorted(runs_by_name().get(name, []))
    if not durs:
        return None, 0
    return _percentile(durs, 90), len(durs)


def task_elapsed(task):
    now = time.time()
    state = task["state"]
    if state == "running":
        t = task_epoch(task, "started")
        return fmt_elapsed(max(0, now - t) if t is not None else None)
    elif state in ("done", "failed", "cancelled"):
        if isinstance(task.get("duration_secs"), int):
            return fmt_elapsed(task["duration_secs"])
        t0, t1 = task_epoch(task, "started"), task_epoch(task, "finished")
        if t0 is not None and t1 is not None and t1 >= t0:
            return fmt_elapsed(t1 - t0)
    elif state == "pending":
        t = task_epoch(task, "submitted")
        if t is not None:
            return f"wait:{fmt_elapsed(max(0, now - t))}"
    return "—"


# ── .hive file parser ─────────────────────────────────────────────────────────

def parse_hive_file(path):
    """
    Parse a .hive script file.
    Lines starting with #HIVE key=value set metadata.
    Remaining non-comment lines form the command.

    Returns dict with keys: cmd, workdir, priority, name, owner, need_mb, gpus, est_runtime
    """
    meta = {}
    cmd_lines = []

    with open(path) as f:
        for line in f:
            stripped = line.rstrip('\n')
            m = re.match(r'^#HIVE\s+(\w+)\s*=\s*(.+)$', stripped)
            if m:
                meta[m.group(1).lower()] = m.group(2).strip()
            elif stripped.startswith('#!') or stripped.startswith('#'):
                continue   # shebang / comment
            else:
                cmd_lines.append(stripped)

    # Join non-empty command lines
    cmd = '\n'.join(l for l in cmd_lines if l.strip()).strip()
    if not cmd:
        raise ValueError(f"No commands found in {path}")

    result = {"cmd": cmd}
    if "workdir" in meta:
        result["workdir"] = os.path.expanduser(meta["workdir"])
    if "priority" in meta:
        try:
            result["priority"] = int(meta["priority"])
        except ValueError:
            pass
    if "name" in meta:
        result["name"] = meta["name"]
    if "owner" in meta:
        result["owner"] = meta["owner"]
    if "need_mb" in meta:
        try:
            result["need_mb"] = int(meta["need_mb"])
        except ValueError:
            pass
    if "gpus" in meta:
        try:
            result["gpus"] = int(meta["gpus"])
        except ValueError:
            pass
    if "est_runtime" in meta:
        result["est_runtime"] = meta["est_runtime"]   # parsed/resolved in cmd_submit

    return result


# ── Daemon management ─────────────────────────────────────────────────────────

def read_sched_pid():
    if not os.path.exists(SCHED_PID):
        return None, None
    try:
        with open(SCHED_PID) as f:
            lines = f.read().strip().split('\n')
        pid = int(lines[0])
        host = lines[1] if len(lines) > 1 else None
        return pid, host
    except (ValueError, IndexError, OSError):
        return None, None


def is_sched_running():
    pid, host = read_sched_pid()

    # If the scheduler is recorded on THIS host, the live PID is authoritative —
    # detect a killed scheduler immediately rather than trusting a stale-but-recent
    # heartbeat (which would block a restart for up to HEARTBEAT_DAEMON_TIMEOUT and
    # mask an unexpected death).
    if pid is not None and (not host or host == socket.gethostname()):
        try:
            os.kill(pid, 0)
            return True
        except (ProcessLookupError, PermissionError):
            return False

    # Different (or unknown) host: rely on the shared-FS heartbeat freshness.
    if os.path.exists(SCHED_HB):
        age = time.time() - os.path.getmtime(SCHED_HB)
        if age < HEARTBEAT_DAEMON_TIMEOUT:
            return True

    return False


def cmd_daemon(args):
    sub = args.subcmd if hasattr(args, 'subcmd') else "status"

    if sub == "start":
        os.makedirs(HIVE_DIR, exist_ok=True)
        # Atomic start mutex: when many agents `hive submit` simultaneously with no
        # scheduler yet running, a plain check-then-start (TOCTOU) lets each spawn its
        # own hive-sched. An flock serializes the check+start so only one wins.
        # flock is always same-node-atomic; cross-node-atomic where the shared FS
        # honors it. We also publish liveness immediately so racers bail fast.
        lock_fd = open(SCHED_START_LOCK, "w")
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("hive-sched start already in progress on another agent")
            lock_fd.close()
            return
        try:
            if is_sched_running():
                pid, _ = read_sched_pid()
                print(f"hive-sched is already running (PID {pid})")
                return
            proc = subprocess.Popen(
                [PYTHON, SCHED_BIN],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            # Publish pid+host and a heartbeat NOW (the child also writes these, but
            # not until it boots) so a concurrent starter sees "running" immediately.
            try:
                with open(SCHED_PID, "w") as f:
                    f.write(f"{proc.pid}\n{socket.gethostname()}\n")
                with open(SCHED_HB, "w") as f:
                    f.write(now_iso())
            except OSError:
                pass
            time.sleep(0.6)
            print(f"hive-sched started (PID {proc.pid})")
        finally:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            lock_fd.close()

    elif sub == "stop":
        pid, _ = read_sched_pid()
        if pid is None or not is_sched_running():
            print("hive-sched is not running")
            return
        try:
            os.kill(pid, signal.SIGTERM)
            print(f"hive-sched stopped (PID {pid})")
        except ProcessLookupError:
            print("hive-sched: process not found (stale PID file)")

    elif sub == "restart":
        cmd_daemon(argparse.Namespace(subcmd="stop"))
        time.sleep(1)
        cmd_daemon(argparse.Namespace(subcmd="start"))

    elif sub == "status":
        if is_sched_running():
            pid, host = read_sched_pid()
            hb_age = None
            if os.path.exists(SCHED_HB):
                hb_age = int(time.time() - os.path.getmtime(SCHED_HB))
            print(f"hive-sched: {C_GREEN}running{C_RESET}  PID {pid}  host {host}  "
                  f"last heartbeat {hb_age}s ago")
        else:
            print(f"hive-sched: {C_RED}stopped{C_RESET}")

    elif sub == "logs":
        if not os.path.exists(SCHED_LOG):
            print("No scheduler log found.")
            return
        subprocess.run(["tail", "-n", "40", SCHED_LOG])

    else:
        print(f"hive queue daemon: unknown subcommand '{sub}'", file=sys.stderr)
        sys.exit(1)


# ── Submit ────────────────────────────────────────────────────────────────────

def cmd_submit(args):
    target = args.cmd_or_file

    # Detect .hive file vs plain command string
    if os.path.isfile(target):
        spec = parse_hive_file(target)
    else:
        spec = {"cmd": target}

    # Reject cmds that contain srun — hive handles dispatch internally;
    # nested srun causes fragile double-dispatch into the same job cgroup.
    cmd_first_line = spec["cmd"].strip().split('\n')[0].strip()
    if re.match(r'\bsrun\b', cmd_first_line) or re.search(r';\s*srun\b', spec["cmd"]):
        print(f"{C_RED}Error:{C_RESET} cmd must not contain 'srun'.", file=sys.stderr)
        print("hive dispatches to the node via srun internally.", file=sys.stderr)
        print("Remove the srun prefix and submit just the command:", file=sys.stderr)
        print(f"  hive submit \"python train.py ...\"", file=sys.stderr)
        sys.exit(1)

    # CLI flags override .hive directives
    if args.workdir:
        spec["workdir"] = os.path.abspath(args.workdir)
    elif "workdir" not in spec:
        spec["workdir"] = os.getcwd()

    if args.priority is not None:
        spec["priority"] = args.priority
    elif "priority" not in spec:
        spec["priority"] = 0

    if args.name:
        spec["name"] = args.name

    # Owner tag: who/what this task belongs to (an agent name, a project, a campaign).
    # Several agents share one queue, so each needs to find its own tasks again:
    # --owner > #HIVE owner= > $HIVE_OWNER (export once per agent session).
    if getattr(args, "owner", None):
        spec["owner"] = args.owner
    elif "owner" not in spec and os.environ.get("HIVE_OWNER"):
        spec["owner"] = os.environ["HIVE_OWNER"].strip()

    if getattr(args, "need_mb", None) is not None:
        spec["need_mb"] = args.need_mb

    # GPU count. CLI --gpus > #HIVE gpus= > DEFAULT_TASK_GPUS (1).
    # Defaulting to 1 is deliberate: a hold job may own several GPUs, and a
    # framework that auto-parallelizes over every visible device (HF Trainer →
    # nn.DataParallel) then crashes or silently spreads a model it shouldn't.
    # Multi-GPU is opt-in via `#HIVE gpus=N` / `--gpus N` (feedback #8).
    if getattr(args, "gpus", None) is not None:
        spec["gpus"] = args.gpus
    elif "gpus" not in spec:
        spec["gpus"] = DEFAULT_TASK_GPUS
    if spec["gpus"] < 0:
        print(f"{C_RED}error: --gpus must be >= 0{C_RESET}", file=sys.stderr)
        sys.exit(2)

    # Runtime estimate (drives walltime-aware scheduling). Source priority:
    # CLI --est-runtime > #HIVE est_runtime=. Value 'auto' resolves from history.
    est_raw = None
    if getattr(args, "est_runtime", None) is not None:
        est_raw = args.est_runtime
    elif "est_runtime" in spec:
        est_raw = spec["est_runtime"]

    # Resolve the estimate BEFORE taking the queue lock — history_estimate() scans
    # events.jsonl + queue.json (reads only), and a few seconds of staleness in that
    # history is harmless. Keeping it out of the lock avoids holding queue.lock during a
    # potentially large history scan (review #2).
    est_secs, est_source = None, None
    if est_raw is not None:
        if str(est_raw).strip().lower() == "auto":
            est_secs, n = history_estimate(spec.get("name", ""))
            if est_secs:
                est_source = "history"
                print(f"(auto estimate from {n} past '{spec.get('name')}' run(s))")
            else:
                print("(no runtime history for this name yet — "
                      "submitting without an estimate)")
        else:
            est_secs = parse_duration(est_raw)
            if est_secs:
                est_source = "user"
            else:
                print(f"{C_YELLOW}Warning:{C_RESET} could not parse "
                      f"--est-runtime '{est_raw}'; ignoring.")

    with QueueLock() as lfd:
        queue = load_queue(lfd)
        task_id = queue["next_id"]
        queue["next_id"] += 1

        task = {
            "id":           task_id,
            "cmd":          spec["cmd"],
            "workdir":      spec.get("workdir", os.getcwd()),
            "name":         spec.get("name", ""),
            "owner":        spec.get("owner", ""),
            "state":        "pending",
            "priority":     spec.get("priority", 0),
            "submitted_at": now_iso(),
            "submitted_ts": now_ts(),
            "started_at":   None,
            "finished_at":  None,
            "slurm_jobid":  None,
            "node":         None,
            "srun_pid":     None,
            "exit_code":    None,
            "need_mb":      spec.get("need_mb", 0),
            "gpus":         spec.get("gpus", DEFAULT_TASK_GPUS),
            "est_runtime_secs":    est_secs,
            "est_source":          est_source,
            "requeue_count":       0,
            "checkpoint_warning":  False,
            "node_time_left_secs": None,
            "duration_secs":       None,
            "queued_secs":         None,
            "log":          os.path.join(LOG_DIR, f"task-{task_id}.log"),
        }
        queue["tasks"][str(task_id)] = task
        save_queue(queue, lfd)
        ev.record("submit", task=task_id, name=spec.get("name") or None,
                  owner=spec.get("owner") or None,
                  est_runtime_secs=est_secs, need_mb=spec.get("need_mb") or None,
                  priority=spec.get("priority") or None)

    print(f"Submitted task #{task_id}" + (f"  (owner: {spec['owner']})" if spec.get("owner") else ""))
    if est_secs:
        print(f"  runtime estimate: {fmt_elapsed(est_secs)} (source: {est_source}) — "
              f"scheduler will avoid nodes with < estimate + 10m walltime left")
    print(f"{C_DIM}  ↻ on node reclaim this is auto-requeued & RE-RUN from scratch — make the "
          f"command resumable (checkpoint / skip already-done outputs).{C_RESET}")

    # Auto-start scheduler daemon if not running
    if not is_sched_running():
        print("Starting hive-sched...")
        cmd_daemon(argparse.Namespace(subcmd="start"))


# ── List ──────────────────────────────────────────────────────────────────────

DONE_HIDE_DAYS_DEFAULT = 7   # default window: hide terminal tasks finished > N days ago
LIST_LIMIT_DEFAULT     = 10  # ...and show at most this many of them. `hive list` is run by
                             # agents many times per session; 7 days of history was 250+
                             # lines / 33 KB per call, all of it landing in their context.
                             # Active tasks are always shown in full.


def _date_label(d):
    """Calendar-date group header label: 'Today  06-08', else 'MM-DD' (or 'YYYY-MM-DD'
    in another year)."""
    if d is None:
        return "no finish date"
    today = datetime.now().date()
    md = d.strftime('%m-%d') if d.year == today.year else d.strftime('%Y-%m-%d')
    if d == today:
        return f"Today  {md}"
    if d == today - timedelta(days=1):
        return f"Yesterday  {md}"
    return md


def cmd_list(args):
    queue = load_queue()
    all_tasks = list(queue.get("tasks", {}).values())

    filter_state = args.state.lower() if args.state else None
    show_all     = getattr(args, "all", False)
    # Owner filter: explicit --owner wins; otherwise a session with $HIVE_OWNER set
    # sees only its own tasks by default (that is why the variable exists);
    # `--owner all` shows everyone's.
    owner = getattr(args, "owner", None) or os.environ.get("HIVE_OWNER", "").strip() or None
    if owner and owner.lower() == "all":
        owner = None
    if owner:
        all_tasks = [t for t in all_tasks if (t.get("owner") or "") == owner]
    days         = getattr(args, "days", None) or DONE_HIDE_DAYS_DEFAULT
    limit        = getattr(args, "limit", None)
    if limit is None:
        limit = 0 if show_all else LIST_LIMIT_DEFAULT   # --all lifts the cap; --limit 0 too

    # ── Windowing: keep active (running/pending) always; hide terminal tasks
    # finished more than `days` ago unless --all / --state is set. ────────────────
    hidden_count = 0
    cutoff = None
    if filter_state:
        tasks = [t for t in all_tasks if t["state"] == filter_state]
    elif show_all:
        tasks = all_tasks
    else:
        cutoff = datetime.now() - timedelta(days=days)
        visible = []
        for t in all_tasks:
            if t["state"] in TERMINAL_STATES:
                fin = task_finished_dt(t)
                if fin is not None and fin < cutoff:
                    hidden_count += 1
                    continue
            visible.append(t)
        tasks = visible

    if not tasks:
        who = f" for owner '{owner}'" if owner else ""
        if hidden_count:
            print(f"No tasks{who} in the last {days}d ({hidden_count} older hidden — "
                  f"hive list --all).")
        else:
            print(f"No tasks found{who}." + ("  (hive list --owner all)" if owner else ""))
        return

    active   = [t for t in tasks if t["state"] in ("running", "pending")]
    terminal = [t for t in tasks if t["state"] in TERMINAL_STATES]
    active.sort(key=lambda t: -t["id"])
    # Terminal newest-first; group by finish date below.
    terminal.sort(key=lambda t: (task_finished_dt(t) or datetime.min, t["id"]),
                  reverse=True)
    terminal_total = len(terminal)
    capped = 0
    if limit and terminal_total > limit:
        capped = terminal_total - limit
        terminal = terminal[:limit]
    tasks = active + terminal

    # For PENDING tasks the NODE column is empty, so we reuse it to show *why* the
    # task hasn't dispatched (set by the scheduler — feedback OBSERVED#8 / SESSION#8).
    def node_display(t):
        if t["state"] == "pending" and t.get("pending_reason"):
            base = t["pending_reason"]
        else:
            base = t.get("node") or "—"
        # Flag tasks that were re-dispatched after a node was reclaimed mid-run, so the
        # checkpoint-loss is visible at a glance (full warning is in the log / hive wait).
        rq = t.get("requeue_count", 0) or 0
        if rq and t["state"] in ("pending", "running"):
            base = f"{base} (re-disp x{rq})"
        return base

    # Column widths (over everything shown). OWNER column only when it carries
    # information: some shown task has an owner and we're not already filtered to one.
    id_w    = max(len(str(t["id"])) for t in tasks)
    name_w  = max(len(t.get("name") or "—") for t in tasks)
    name_w  = max(name_w, 6)
    show_owner = (not owner) and any(t.get("owner") for t in tasks)
    owner_w = max((len(t.get("owner") or "—") for t in tasks), default=5) if show_owner else 0
    owner_w = max(owner_w, 5) if show_owner else 0
    state_w = 10   # fits CANCELLING
    node_w  = max((len(node_display(t)) for t in tasks), default=4)
    node_w  = max(node_w, 4)
    elap_w  = 10
    cmd_avail = max(40, 80 - id_w - name_w - state_w - node_w - elap_w - 12)

    def truncate(s, n):
        return s if len(s) <= n else s[:n-1] + "…"

    owner_h = f"{'OWNER':<{owner_w}}  " if show_owner else ""
    header = (f"  {'ID':>{id_w}}  {owner_h}{'NAME':<{name_w}}  {'STATE':<{state_w}}  "
              f"{'NODE':<{node_w}}  {'ELAPSED':<{elap_w}}  CMD")
    width = len(header) - 2
    sep = "  " + "─" * width

    def group_line(label):
        text = f"── {label} "
        return f"  {C_DIM}{text}{'─' * max(0, width - len(text))}{C_RESET}"

    def print_row(t):
        tid     = str(t["id"])
        name    = t.get("name") or "—"
        state   = t["state"]
        node    = node_display(t)
        elapsed = task_elapsed(t)
        cmd     = truncate(t["cmd"].replace('\n', ' '), cmd_avail)
        color = STATE_COLORS.get(state, "")
        label = state.upper()
        if state == "running" and t.get("cancel_requested"):
            label, color = "CANCELLING", C_YELLOW   # scheduler will stop it within a cycle
        state_str = f"{color}{label:<{state_w}}{C_RESET}"
        owner_c = f"{(t.get('owner') or '—'):<{owner_w}}  " if show_owner else ""
        print(f"  {tid:>{id_w}}  {owner_c}{name:<{name_w}}  {state_str}  "
              f"{node:<{node_w}}  {elapsed:<{elap_w}}  {cmd}")

    # ── Scope line (makes the current view explicit) ─────────────────────────────
    r = sum(1 for t in tasks if t["state"] == "running")
    p = sum(1 for t in tasks if t["state"] == "pending")
    who = f"owner={owner} · " if owner else ""
    if filter_state:
        scope = f"queue · {who}filter={filter_state} · {len(tasks)} of {terminal_total or len(tasks)} shown"
    elif show_all:
        scope = f"queue · {who}{r} running · {p} pending · all history ({terminal_total} terminal)"
    else:
        scope = (f"queue · {who}{r} running · {p} pending · {len(terminal)} of {terminal_total} "
                 f"finished in last {days}d shown")
    if owner:
        scope += " · others: --owner all"
    if capped:
        scope += f" · +{capped} more (--limit N)"
    if hidden_count and not show_all:
        scope += f" · {hidden_count} older (--all)"
    print(f"{C_BOLD}{scope}{C_RESET}")

    print(f"{C_BOLD}{header}{C_RESET}")
    print(sep)

    # Active first (no date header — they're current)
    for t in active:
        print_row(t)

    # Terminal grouped by finish date (newest group first)
    prev_date = None
    for t in terminal:
        fin = task_finished_dt(t)
        d = fin.date() if fin else None
        if d != prev_date:
            print(group_line(_date_label(d)))
            prev_date = d
        print_row(t)

    print()
    sched_status = f"{C_GREEN}running{C_RESET}" if is_sched_running() else f"{C_RED}stopped{C_RESET}"
    footer = f"  {C_DIM}scheduler: {sched_status}"
    if capped or hidden_count:
        footer += f"  ·  +{capped + hidden_count} more: hive list --limit N | --all | --state S"
    footer += C_RESET
    print(footer)


# ── Cancel ────────────────────────────────────────────────────────────────────

def cmd_cancel(args):
    task_id = str(args.id)
    with QueueLock() as lfd:
        queue = load_queue(lfd)
        task = queue["tasks"].get(task_id)
        if not task:
            print(f"Task #{task_id} not found.", file=sys.stderr)
            sys.exit(1)
        if task["state"] not in ("pending", "running"):
            print(f"Task #{task_id} is already {task['state']} — cannot cancel.")
            return

        if task["state"] == "running":
            # The srun step is a child of hive-sched, which may run on ANOTHER node
            # (state is on the shared FS). A host-local os.kill from here would then
            # miss it — the task read "cancelled" while the step kept the GPU busy —
            # or hit an unrelated process with the same PID number. So: signal it
            # directly only when the scheduler is on this host; otherwise record the
            # request and let the scheduler act on it within one cycle (~30s).
            srun_pid = task.get("srun_pid")
            _, sched_host = read_sched_pid()
            sched_local = (not sched_host) or sched_host == socket.gethostname()
            sched_alive = is_sched_running()
            if sched_local and srun_pid:
                try:
                    os.kill(srun_pid, signal.SIGTERM)
                    print(f"Sent SIGTERM to srun PID {srun_pid}")
                except (ProcessLookupError, PermissionError):
                    print(f"srun process {srun_pid} already gone")
            elif sched_alive:
                task["cancel_requested"] = now_iso()
                save_queue(queue, lfd)
                print(f"Task #{task_id} cancel requested — the scheduler on "
                      f"{sched_host or '?'} owns the srun step and will stop it within "
                      f"~30s (hive list shows CANCELLING until then).")
                return
            else:
                print(f"{C_YELLOW}Warning:{C_RESET} scheduler is not running and its host "
                      f"({sched_host or '?'}) is not this one — cannot signal srun PID "
                      f"{srun_pid}. Marking cancelled; the step (if any) may linger on "
                      f"{task.get('node') or '?'}.")

        task["state"]       = "cancelled"
        task["finished_at"] = now_iso()
        task["finished_ts"] = now_ts()
        save_queue(queue, lfd)
        ev.record("cancel", task=task["id"], name=task.get("name") or None,
                  node=task.get("node"))
    print(f"Task #{task_id} cancelled.")


# ── Logs ──────────────────────────────────────────────────────────────────────

LOG_FULL_MAX_LINES = 200   # print a log whole up to this many lines...
LOG_TAIL_DEFAULT   = 100   # ...otherwise only its last N (agents read logs into context)


def print_log(log_file, tail=None, full=False, task_id=None):
    """Print a task log without flooding the caller's context. Whole file when it is
    short (≤ LOG_FULL_MAX_LINES) or `full`; otherwise the last `tail` lines with a
    one-line pointer to the rest. The header (first 8 lines: node, cmd, gpus…) is kept
    when tailing since it is what makes a tail interpretable."""
    try:
        with open(log_file, errors="replace") as f:
            lines = f.readlines()
    except OSError as e:
        print(f"(cannot read log: {e})")
        return
    n = len(lines)
    if full or tail == 0 or n <= max(LOG_FULL_MAX_LINES, tail or 0):
        sys.stdout.write("".join(lines))
        return
    tail = tail or LOG_TAIL_DEFAULT
    head = [ln for ln in lines[:8] if ln.startswith("===")]
    body = lines[-tail:]
    omitted = n - len(head) - len(body)
    sys.stdout.write("".join(head))
    ref = f"hive logs {task_id} --full" if task_id is not None else "--full"
    print(f"{C_DIM}… {omitted} lines omitted ({n} total) — {ref}, or -n N for a longer tail …{C_RESET}")
    sys.stdout.write("".join(body))


def cmd_logs(args):
    task_id = str(args.id)
    queue = load_queue()
    task = queue["tasks"].get(task_id)
    # A pruned task is gone from queue.json, but its log file (deterministic path) may
    # still be on disk — fall back to it so `hive logs` keeps working after a prune.
    log_file = (task or {}).get("log") or os.path.join(LOG_DIR, f"task-{task_id}.log")
    if not task and not os.path.exists(log_file):
        print(f"Task #{task_id} not found.", file=sys.stderr)
        sys.exit(1)
    if not os.path.exists(log_file):
        print(f"No log file yet for task #{task_id}.")
        if task["state"] == "pending":
            print("(Task is still pending — it hasn't started yet.)")
        return

    if args.follow:
        try:
            subprocess.run(["tail", "-f", log_file])
        except KeyboardInterrupt:
            pass
    else:
        print_log(log_file, tail=args.tail, full=args.full, task_id=task_id)



# ── Wait ──────────────────────────────────────────────────────────────────────

TERMINAL_STATES = {"done", "failed", "cancelled"}

def cmd_wait(args):
    """Block until task reaches a terminal state, then print log and exit with task's exit code.

    Intended for agent workflows:
        TASK_ID=$(hive queue submit "cmd" | grep -oP '#\\K\\d+')
        hive queue wait $TASK_ID   # blocks, then exit $?
    """
    task_id   = str(args.id)
    poll_secs = args.interval
    no_log    = args.no_log

    print(f"Waiting for task #{task_id}...", flush=True)

    pending_timeout = getattr(args, "pending_timeout", 0) or 0

    prev_state = None
    prev_requeue = 0
    prev_reason = None
    pending_since = None
    while True:
        queue = load_queue()
        task  = queue["tasks"].get(task_id)
        if not task:
            print(f"Task #{task_id} not found.", file=sys.stderr)
            sys.exit(2)

        state = task["state"]
        if state != prev_state:
            node    = task.get("node") or "—"
            elapsed = task_elapsed(task)
            color   = STATE_COLORS.get(state, "")
            print(f"  [{elapsed}] {color}{state.upper()}{C_RESET}"
                  + (f"  on {node}" if node != "—" else ""),
                  flush=True)
            prev_state = state

        # Tell the agent when the task was moved to another node mid-run: the new run
        # does NOT resume from the interrupted one unless the command checkpoints.
        rq = task.get("requeue_count", 0) or 0
        if rq > prev_requeue:
            reason = task.get("pending_reason") or "node reclaimed"
            print(f"  {C_YELLOW}⚠ re-dispatched to a different node "
                  f"(attempt {task.get('attempts', rq)}, reason: {reason}). "
                  f"Earlier progress is LOST unless your command resumes from a "
                  f"checkpoint.{C_RESET}", flush=True)
            prev_requeue = rq

        # Surface WHY a task is held (so the agent perceives a block instead of waiting
        # blind). `insufficient_walltime` in particular may never clear on its own.
        if state == "pending":
            if pending_since is None:
                pending_since = time.time()
            reason = task.get("pending_reason")
            if reason and reason != prev_reason:
                if reason == "insufficient_walltime":
                    est = task.get("est_runtime_secs")
                    print(f"  {C_YELLOW}⚠ held: insufficient_walltime — no node has enough "
                          f"remaining walltime for est {fmt_elapsed(est) if est else '?'} "
                          f"(+10m margin). It will NOT run until a longer-walltime node is "
                          f"added (hive pool add --time …) or you lower --est-runtime."
                          f"{C_RESET}", flush=True)
                else:
                    print(f"  {C_DIM}pending: {reason}{C_RESET}", flush=True)
                prev_reason = reason
            if pending_timeout and (time.time() - pending_since) > pending_timeout:
                print(f"  {C_RED}gave up: task still PENDING "
                      f"({task.get('pending_reason') or 'unscheduled'}) after "
                      f"{int(time.time() - pending_since)}s — it never dispatched."
                      f"{C_RESET}", flush=True)
                sys.exit(75)
        else:
            pending_since = None

        if state in TERMINAL_STATES:
            break

        time.sleep(poll_secs)

    # ── Explicit timing feedback returned to the agent ───────────────────────
    # Real measured durations (no estimate): queue wait + run time on the node, plus a
    # re-dispatch count if the node was reclaimed mid-run. Prefer the values the
    # scheduler recorded at finish; fall back to computing from timestamps.
    qs = task.get("queued_secs")
    if qs is None:
        t0, t1 = task_epoch(task, "submitted"), task_epoch(task, "started")
        qs = int(t1 - t0) if t0 is not None and t1 is not None and t1 >= t0 else None
    rs = task.get("duration_secs")
    if rs is None:
        t0, t1 = task_epoch(task, "started"), task_epoch(task, "finished")
        rs = int(t1 - t0) if t0 is not None and t1 is not None and t1 >= t0 else None
    node = task.get("node") or "—"
    mark = {"done": f"{C_GREEN}✓", "failed": f"{C_RED}✗",
            "cancelled": f"{C_DIM}∅"}.get(state, "")
    parts = []
    if qs is not None:
        parts.append(f"queued {fmt_elapsed(qs)}")
    if rs is not None:
        parts.append(f"ran {fmt_elapsed(rs)}")
    if task.get("requeue_count"):
        parts.append(f"re-disp x{task['requeue_count']}")
    detail = " · ".join(parts)
    print(f"{mark} task #{task_id} {state}{C_RESET}"
          + (f" · {detail}" if detail else "")
          + (f" · on {node}" if node != "—" else ""), flush=True)

    # Print the log — tail only, by default. `hive wait` is the agent's blocking call;
    # dumping a 2,500-line training log into its context at every completion was the
    # single biggest source of context bloat. The header + last lines carry the verdict.
    if not no_log:
        log_file = task.get("log", os.path.join(LOG_DIR, f"task-{task_id}.log"))
        if os.path.exists(log_file):
            print()
            print(f"{C_DIM}{'─'*60}{C_RESET}")
            print_log(log_file, tail=getattr(args, "log_lines", None),
                      full=getattr(args, "full_log", False), task_id=task_id)
            print(f"{C_DIM}{'─'*60}{C_RESET}")
        else:
            print("(no log file found)")

    # Exit with task's exit code so callers can check $?
    ec = task.get("exit_code")
    if state == "cancelled":
        sys.exit(130)
    elif ec is not None:
        sys.exit(ec if ec >= 0 else 1)
    else:
        sys.exit(0 if state == "done" else 1)


# ── Stats (runtime history → estimate helper for agents) ──────────────────────

def cmd_stats(args):
    """Show completed-task runtime history grouped by name, so an agent can pick an
    --est-runtime value (or just pass --est-runtime auto, which uses p90 here). Reads
    the durable event log (`events.jsonl`) merged with any done tasks still in the
    queue, so history survives even after the queue is pruned."""
    name = getattr(args, "name", None)

    groups = {(k or "—"): v for k, v in runs_by_name().items()}
    if name:
        groups = {k: v for k, v in groups.items() if k == name}

    if not groups:
        scope = f" for name '{name}'" if name else ""
        print(f"No completed-task runtime history{scope} yet.")
        print("(History accrues as named tasks finish; submit with --name to group them.)")
        return

    name_w = max([len(k) for k in groups], default=4)
    name_w = max(name_w, 4)
    header = (f"  {'NAME':<{name_w}}  {'N':>3}  {'MIN':>8}  {'MED':>8}  "
              f"{'P90':>8}  {'MAX':>8}")
    print(f"{C_BOLD}{header}{C_RESET}")
    print("  " + "─" * (len(header) - 2))
    for nm in sorted(groups):
        durs = sorted(groups[nm])
        n = len(durs)
        mn, md = durs[0], _percentile(durs, 50)
        p90, mx = _percentile(durs, 90), durs[-1]
        print(f"  {nm:<{name_w}}  {n:>3}  {fmt_elapsed(mn):>8}  {fmt_elapsed(md):>8}  "
              f"{fmt_elapsed(p90):>8}  {fmt_elapsed(mx):>8}")
    print()
    print(f"  {C_DIM}Tip: hive submit --name <NAME> --est-runtime auto  "
          f"(uses P90 above so the scheduler avoids soon-expiring nodes).{C_RESET}")


# ── Remove ────────────────────────────────────────────────────────────────────

def cmd_rm(args):
    task_id = str(args.id)
    with QueueLock() as lfd:
        queue = load_queue(lfd)
        task = queue["tasks"].get(task_id)
        if not task:
            print(f"Task #{task_id} not found.", file=sys.stderr)
            sys.exit(1)
        if task["state"] in ("running", "pending"):
            print(f"Task #{task_id} is still {task['state']}. Use 'cancel' first.")
            sys.exit(1)

        del queue["tasks"][task_id]
        save_queue(queue, lfd)
    print(f"Task #{task_id} removed.")


# ── Prune ─────────────────────────────────────────────────────────────────────

PRUNE_DEFAULT_OLDER = 7 * 86400   # default: keep the last 7 days of terminal tasks


def _drop_internal_files(task_id, log_path, drop_logs):
    """Remove a pruned task's internal scheduler files (heartbeat + exit), and its log
    only if explicitly asked (`--logs`). Logs hold the task's actual output, so they're
    kept by default."""
    for p in (os.path.join(HEARTBEAT_DIR, str(task_id)),
              os.path.join(HEARTBEAT_DIR, f"{task_id}.exit")):
        try:
            os.remove(p)
        except OSError:
            pass
    if drop_logs and log_path:
        try:
            os.remove(log_path)
        except OSError:
            pass


def cmd_prune(args):
    """Remove old terminal (done/failed/cancelled) tasks from queue.json. Never touches
    pending/running. The durable timing history stays in events.jsonl, so this only
    trims the live queue — use it to keep queue.json small. Logs are kept unless
    --logs is given; heartbeat/exit files are always cleaned for pruned tasks."""
    older_than = None
    if args.older_than is not None:
        older_than = parse_duration(args.older_than)
        if older_than is None:
            print(f"{C_RED}Error:{C_RESET} could not parse --older-than "
                  f"'{args.older_than}' (try 24h, 7d, or 0 for all).", file=sys.stderr)
            sys.exit(1)
    state_filter = args.state.lower() if args.state else None
    if state_filter and state_filter not in TERMINAL_STATES:
        print(f"{C_RED}Error:{C_RESET} --state must be one of done|failed|cancelled.",
              file=sys.stderr)
        sys.exit(1)

    now = datetime.now()

    def finished(t):
        return task_finished_dt(t)

    with QueueLock() as lfd:
        queue = load_queue(lfd)
        tasks = queue.get("tasks", {})
        cand = [t for t in tasks.values()
                if t["state"] in TERMINAL_STATES
                and (not state_filter or t["state"] == state_filter)]

        if args.keep is not None:
            # Keep the N most-recent terminal tasks (by finish time); prune the rest.
            ordered = sorted(cand, key=lambda t: (finished(t) or datetime.min),
                             reverse=True)
            victims = ordered[max(0, args.keep):]
        else:
            thr = older_than if older_than is not None else PRUNE_DEFAULT_OLDER
            victims = []
            for t in cand:
                f = finished(t)
                age = (now - f).total_seconds() if f else None
                if thr == 0 or (age is not None and age >= thr):
                    victims.append(t)

        if not victims:
            print("Nothing to prune (no terminal tasks match the criteria).")
            return

        # Summary by state
        by_state = {}
        for t in victims:
            by_state[t["state"]] = by_state.get(t["state"], 0) + 1
        summary = ", ".join(f"{n} {s}" for s, n in sorted(by_state.items()))

        if args.dry_run:
            print(f"{C_BOLD}[dry-run]{C_RESET} would prune {len(victims)} task(s): {summary}")
            for t in sorted(victims, key=lambda t: t["id"])[:20]:
                print(f"  #{t['id']:>5}  {t['state']:<9}  {t.get('name') or '—'}")
            if len(victims) > 20:
                print(f"  … and {len(victims) - 20} more")
            remain = len(tasks) - len(victims)
            print(f"{remain} task(s) would remain. (re-run without --dry-run to apply)")
            return

        for t in victims:
            _drop_internal_files(t["id"], t.get("log"), args.logs)
            del tasks[str(t["id"])]
        save_queue(queue, lfd)
        ev.record("prune", count=len(victims), by_state=by_state,
                  logs_removed=bool(args.logs))

    remain = len(tasks)
    print(f"Pruned {len(victims)} task(s): {summary}.  {remain} task(s) remain.")
    if not args.logs:
        print(f"{C_DIM}(task logs kept; use --logs to also delete them. "
              f"History is preserved in events.jsonl.){C_RESET}")


# ── Argument parsing ──────────────────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="hive queue",
        description="hive task queue — submit and manage experiments on pre-allocated nodes",
    )
    sub = p.add_subparsers(dest="command", metavar="COMMAND")
    sub.required = True

    # submit
    ps = sub.add_parser("submit", help="Submit a task (command string or .hive file)")
    ps.add_argument("cmd_or_file", metavar="CMD|FILE",
                    help='Command string or path to a .hive script file')
    ps.add_argument("--workdir", "-w", metavar="DIR",
                    help="Working directory (default: current directory)")
    ps.add_argument("--priority", "-p", type=int, metavar="N",
                    help="Priority (higher = runs first, default: 0)")
    ps.add_argument("--name", "-n", metavar="NAME",
                    help="Display name for this task")
    ps.add_argument("--owner", "-o", metavar="OWNER",
                    help="Who this task belongs to (agent / project name) — filter later with "
                         "`hive list --owner OWNER`. Default: #HIVE owner= or $HIVE_OWNER")
    ps.add_argument("--need-mb", type=int, metavar="MB", dest="need_mb",
                    help="Min free GPU memory (MiB) required before dispatch; "
                         "the scheduler holds the task PENDING until a node has it free")
    ps.add_argument("--gpus", type=int, metavar="N",
                    help=f"GPUs this task may see (default: {DEFAULT_TASK_GPUS}). A hold job "
                         f"may own several; extra ones are hidden via CUDA_VISIBLE_DEVICES so "
                         f"frameworks don't auto-DataParallel. Use --gpus 2 for real multi-GPU; "
                         f"the task then only places on a hold job with >= 2 GPUs")
    ps.add_argument("--est-runtime", metavar="DUR", dest="est_runtime",
                    help="Estimated runtime (e.g. 2h, 90m, 1-12:00:00, or 'auto' to use "
                         "P90 of this name's history). The scheduler then won't place the "
                         "task on a node whose remaining walltime < estimate + 10m.")

    # list
    pl = sub.add_parser("list", aliases=["ls"], help="List tasks")
    pl.add_argument("--state", "-s", metavar="STATE",
                    help="Filter by state: pending|running|done|failed|cancelled")
    pl.add_argument("--days", "-d", type=int, metavar="N",
                    help=f"Show terminal tasks finished in the last N days "
                         f"(default {DONE_HIDE_DAYS_DEFAULT}); active tasks always shown")
    pl.add_argument("--all", "-a", action="store_true",
                    help="Show all tasks regardless of age (grouped by date)")
    pl.add_argument("--owner", "-o", metavar="OWNER",
                    help="Only this owner's tasks (default: $HIVE_OWNER if set; 'all' = everyone)")
    pl.add_argument("--limit", "-l", type=int, metavar="N",
                    help=f"Show at most N finished tasks (default {LIST_LIMIT_DEFAULT}; "
                         f"0 = no cap). Active tasks are always shown")

    # cancel
    pc = sub.add_parser("cancel", help="Cancel a pending or running task")
    pc.add_argument("id", type=int, metavar="ID")

    # logs
    pg = sub.add_parser("logs", help="Show task log")
    pg.add_argument("id", type=int, metavar="ID")
    pg.add_argument("-f", "--follow", action="store_true",
                    help="Follow log output (tail -f)")
    pg.add_argument("-n", "--tail", type=int, metavar="N",
                    help=f"Print only the last N lines (default: whole log if ≤ "
                         f"{LOG_FULL_MAX_LINES} lines, else last {LOG_TAIL_DEFAULT})")
    pg.add_argument("--full", action="store_true", help="Print the whole log regardless of length")

    # rm
    pr = sub.add_parser("rm", help="Remove a finished/cancelled task from queue")
    pr.add_argument("id", type=int, metavar="ID")

    # stats
    pst = sub.add_parser("stats", help="Show completed-task runtime history (by name)")
    pst.add_argument("name", nargs="?", metavar="NAME",
                     help="Limit to a single task name")

    # prune
    pp = sub.add_parser("prune", help="Remove old terminal tasks from the queue "
                                      "(history stays in events.jsonl)")
    pp.add_argument("--older-than", metavar="DUR", dest="older_than",
                    help="Prune terminal tasks finished more than DUR ago "
                         "(e.g. 24h, 7d; 0 = all). Default: 7d")
    pp.add_argument("--keep", type=int, metavar="N",
                    help="Instead of age: keep the N most-recent terminal tasks, "
                         "prune the rest")
    pp.add_argument("--state", metavar="STATE",
                    help="Only prune this terminal state: done|failed|cancelled")
    pp.add_argument("--logs", action="store_true",
                    help="Also delete the matching task log files (default: keep them)")
    pp.add_argument("-n", "--dry-run", action="store_true", dest="dry_run",
                    help="Show what would be pruned; change nothing")

    # wait
    pw = sub.add_parser("wait", help="Block until task finishes, print log, exit with task's exit code")
    pw.add_argument("id", type=int, metavar="ID")
    pw.add_argument("--interval", "-i", type=float, default=5.0, metavar="SEC",
                    help="Poll interval in seconds (default: 5)")
    pw.add_argument("--no-log", action="store_true",
                    help="Don't print log on completion")
    pw.add_argument("--log-lines", type=int, default=40, metavar="N", dest="log_lines",
                    help="On completion print only the last N log lines (default 40; "
                         "short logs are printed whole)")
    pw.add_argument("--full-log", action="store_true", dest="full_log",
                    help="On completion print the whole log")
    pw.add_argument("--pending-timeout", type=float, default=0, metavar="SEC",
                    dest="pending_timeout",
                    help="If the task stays PENDING (never dispatches) longer than SEC, "
                         "stop waiting and exit 75. Default 0 = wait forever.")

    # daemon
    pd = sub.add_parser("daemon", help="Manage hive-sched daemon")
    pd.add_argument("subcmd", nargs="?", default="status",
                    choices=["start", "stop", "restart", "status", "logs"],
                    metavar="start|stop|restart|status|logs")

    return p


def main():
    # `hive list | head` closed our stdout early → BrokenPipeError traceback that
    # made a successful command look failed in agent logs (feedback #12). Restore the
    # default SIGPIPE disposition so we exit quietly like any other CLI tool.
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError, OSError):
        pass
    parser = build_parser()
    args = parser.parse_args()

    os.makedirs(HIVE_DIR, exist_ok=True)

    cmd = args.command
    if cmd in ("list", "ls"):
        cmd_list(args)
    elif cmd == "submit":
        cmd_submit(args)
    elif cmd == "cancel":
        cmd_cancel(args)
    elif cmd == "logs":
        cmd_logs(args)
    elif cmd == "rm":
        cmd_rm(args)
    elif cmd == "wait":
        cmd_wait(args)
    elif cmd == "stats":
        cmd_stats(args)
    elif cmd == "prune":
        cmd_prune(args)
    elif cmd == "daemon":
        cmd_daemon(args)


if __name__ == "__main__":
    main()
