#!/usr/bin/env bash
# hive-nodes — node status table + daemon manager (hive nodes subcommand)
# Usage:
#   hive nodes              show table once (auto-starts daemon if not running)
#   hive nodes start        start daemon
#   hive nodes stop         stop daemon
#   hive nodes restart      restart daemon
#   hive nodes status       show daemon status
#   hive nodes logs         tail daemon log
#   hive nodes poll         run one immediate poll
#   hive nodes -h/--help    show help
#
#   For continuous monitoring use: hive top

HIVE_DIR="${HIVE_DIR:-${HOME}/.hive}"
DB_FILE="${DB_FILE:-${HIVE_DIR}/node_monitor.json}"
QUEUE_FILE="${HIVE_DIR}/queue.json"
PID_FILE="${PID_FILE:-${HIVE_DIR}/node_monitor.pid}"
LOG_FILE="${LOG_FILE:-${HIVE_DIR}/node_monitor.log}"
# DAEMON_BIN and POLL_BIN may be exported by the hive dispatcher;
# fall back to sibling in libexec relative to this script
_LIBEXEC="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
DAEMON_BIN="${DAEMON_BIN:-${_LIBEXEC}/hive-daemon}"
POLL_BIN="${POLL_BIN:-${_LIBEXEC}/hive-poll}"

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

# ── daemon helpers ────────────────────────────────────────────────────────────

# Cluster-singleton coordination (feedback C5): the poller may run on ANY node, so
# liveness can't use a host-local `kill -0`. Mirror hive-sched: a hostname-tagged PID
# file + a shared-FS heartbeat. Any node sees "a poller is alive somewhere" and won't
# start a second one.
NODE_HB="${NODE_HB:-${HIVE_DIR}/node_monitor.heartbeat}"
STOP_REQ="${STOP_REQ:-${HIVE_DIR}/node_monitor.stop-request}"
NODE_HB_TIMEOUT="${NODE_HB_TIMEOUT:-180}"   # heartbeat older than this → poller dead

daemon_pid() {   # echo stored PID (first line); no kill-gate (may be a remote host)
    [[ -f "$PID_FILE" ]] || return 1
    local pid; pid=$(sed -n '1p' "$PID_FILE" 2>/dev/null)
    [[ -z "$pid" ]] && return 1
    echo "$pid"
}

daemon_host() {  # echo stored hostname (second line), empty if absent
    [[ -f "$PID_FILE" ]] || return 1
    sed -n '2p' "$PID_FILE" 2>/dev/null
}

daemon_running() {
    local pid host
    pid=$(daemon_pid 2>/dev/null)
    host=$(daemon_host 2>/dev/null)
    # If the poller is recorded on THIS host, the live PID is authoritative — detect a
    # killed daemon immediately instead of trusting a stale-but-recent heartbeat from
    # the dead process (otherwise it looks alive for up to NODE_HB_TIMEOUT).
    if [[ -n "$pid" && ( -z "$host" || "$host" == "$(hostname)" ) ]]; then
        kill -0 "$pid" 2>/dev/null && return 0 || return 1
    fi
    # Different (or unknown) host: rely on the shared-FS heartbeat freshness.
    if [[ -f "$NODE_HB" ]]; then
        local mtime now age
        mtime=$(stat -c %Y "$NODE_HB" 2>/dev/null || stat -f %m "$NODE_HB" 2>/dev/null || echo 0)
        now=$(date +%s)
        age=$(( now - mtime ))
        (( age < NODE_HB_TIMEOUT )) && return 0
    fi
    return 1
}

daemon_start() {
    mkdir -p "$(dirname "$PID_FILE")"
    # Atomic start mutex (same class as the scheduler / feedback C5): when several
    # agents auto-start the poller at once, a check-then-start race could spawn
    # duplicates. flock serializes check+start so only one wins.
    local lock_fd
    exec {lock_fd}>"${HIVE_DIR}/node_monitor.start.lock"
    if ! flock -n "$lock_fd"; then
        exec {lock_fd}>&-
        return 0  # another start in progress
    fi
    if daemon_running; then
        flock -u "$lock_fd"; exec {lock_fd}>&-
        return 0  # a poller is already alive (possibly on another node)
    fi
    nohup "$DAEMON_BIN" >> "$LOG_FILE" 2>&1 &
    local newpid=$!
    printf '%s\n%s\n' "$newpid" "$(hostname)" > "$PID_FILE"   # daemon re-stamps this itself
    date -Iseconds > "$NODE_HB" 2>/dev/null || true          # publish liveness immediately
    flock -u "$lock_fd"; exec {lock_fd}>&-
    echo -e "  ${GREEN}Starting monitor daemon (PID $newpid on $(hostname))...${NC}"
}

daemon_stop() {
    local pid host; pid=$(daemon_pid 2>/dev/null); host=$(daemon_host 2>/dev/null)

    if ! daemon_running; then
        echo -e "  ${DIM}Daemon not running.${NC}"
        rm -f "$PID_FILE" "$NODE_HB"
    elif [[ -n "$host" && "$host" != "$(hostname)" ]]; then
        # Remote poller — can't signal across nodes. Ask it to exit via a stop-request
        # file (it checks every tick); it also self-exits within one heartbeat window.
        : > "$STOP_REQ"
        echo -e "  ${YELLOW}Daemon runs on ${BOLD}$host${NC}${YELLOW} (PID $pid). Wrote stop-request; waiting...${NC}"
        local waited=0
        while daemon_running && (( waited < 15 )); do sleep 1; waited=$(( waited + 1 )); done
        if daemon_running; then
            echo -e "  ${DIM}Still alive after ${waited}s — it will exit within one heartbeat, or ssh $host to kill PID $pid.${NC}"
        else
            echo -e "  ${GREEN}Remote daemon on $host stopped.${NC}"
            rm -f "$PID_FILE" "$NODE_HB"
        fi
        return 0   # don't run the same-host sweep against a remote daemon
    else
        kill -TERM "$pid" 2>/dev/null
        local waited=0
        while kill -0 "$pid" 2>/dev/null && (( waited < 10 )); do
            sleep 1
            waited=$(( waited + 1 ))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -KILL "$pid" 2>/dev/null
            echo -e "  ${RED}Daemon (PID $pid) force-killed after ${waited}s.${NC}"
        else
            echo -e "  ${GREEN}Daemon (PID $pid) stopped.${NC}"
        fi
        rm -f "$PID_FILE" "$NODE_HB"
    fi

    # Sweep: kill any stale hive-daemon main processes ON THIS HOST (running > 60s)
    # that belong to THIS hive instance (same HIVE_DIR). A daemon for a *different*
    # HIVE_DIR on the same host is a separate cluster-singleton, not our zombie —
    # scope by /proc/<pid>/environ so we never kill another instance's poller.
    # Probe subshells also appear as "hive-daemon" in pgrep but complete in < 30s,
    # so the elapsed-time filter reliably targets only lingering local daemon instances.
    local stale_pids=()
    while read -r spid; do
        [[ "$spid" == "$pid" ]] && continue   # already handled above
        local spid_hd
        spid_hd=$(tr '\0' '\n' < "/proc/${spid}/environ" 2>/dev/null \
                  | sed -n 's/^HIVE_DIR=//p' | head -1)
        [[ -z "$spid_hd" ]] && spid_hd="${HOME}/.hive"   # daemon's default when env unset
        [[ "$spid_hd" != "$HIVE_DIR" ]] && continue       # different instance — leave it
        local elapsed
        elapsed=$(ps -o etimes= -p "$spid" 2>/dev/null | tr -d ' ')
        [[ -n "$elapsed" && "$elapsed" -gt 60 ]] && stale_pids+=("$spid")
    done < <(pgrep -f "hive-daemon" 2>/dev/null)

    if (( ${#stale_pids[@]} > 0 )); then
        echo -e "  ${YELLOW}Cleaning up ${#stale_pids[@]} stale daemon process(es): ${stale_pids[*]}${NC}"
        kill -TERM "${stale_pids[@]}" 2>/dev/null
        sleep 1
        for spid in "${stale_pids[@]}"; do
            kill -0 "$spid" 2>/dev/null && kill -KILL "$spid" 2>/dev/null
        done
    fi
}

# ── daemon status footer ──────────────────────────────────────────────────────
show_daemon_footer() {
    local SEP
    SEP=$(printf '%0.s─' {1..83})
    printf "  %s\n" "$SEP"

    if daemon_running; then
        local pid host host_str
        pid=$(daemon_pid); host=$(daemon_host)
        host_str=""
        [[ -n "$host" ]] && host_str=" on $host"
        # Try to get next poll time from last log entry
        local last_poll_epoch=""
        if [[ -f "$LOG_FILE" ]]; then
            local last_ts
            last_ts=$(grep "Poll cycle starting\|DB written" "$LOG_FILE" 2>/dev/null | tail -1 | grep -oP '^\[\K[^\]]+')
            if [[ -n "$last_ts" ]]; then
                last_poll_epoch=$(date -d "$last_ts" +%s 2>/dev/null || date -j -f "%Y-%m-%d %H:%M:%S" "$last_ts" +%s 2>/dev/null)
            fi
        fi

        # Read actual poll interval from daemon startup log line
        local poll_interval=900
        if [[ -f "$LOG_FILE" ]]; then
            local interval_str
            interval_str=$(grep "hive-daemon started" "$LOG_FILE" 2>/dev/null | tail -1 | grep -oP 'interval=\K[0-9]+')
            [[ -n "$interval_str" ]] && poll_interval="$interval_str"
        fi

        local next_str=""
        if [[ -n "$last_poll_epoch" ]]; then
            local now_epoch; now_epoch=$(date +%s)
            local elapsed_since=$(( now_epoch - last_poll_epoch ))
            local remaining=$(( poll_interval - elapsed_since ))
            if (( remaining < 0 )); then remaining=0; fi
            local nm=$(( remaining / 60 )) ns=$(( remaining % 60 ))
            next_str="~${nm}m ${ns}s"
        else
            next_str="unknown"
        fi

        printf "  ${DIM}daemon: ${GREEN}${BOLD}RUNNING${NC}${DIM} (PID $pid$host_str)${NC}  ${DIM}│  next poll: %s  │  log: %s${NC}\n" \
            "$next_str" "$LOG_FILE"
    else
        printf "  ${DIM}daemon: ${RED}${BOLD}STOPPED${NC}${DIM}  │  run ${BOLD}hive daemon start${NC}${DIM} to start  │  log: %s${NC}\n" \
            "$LOG_FILE"
    fi
    echo ""
}

# ── Python helper: parse DB, emit tab-separated rows ─────────────────────────
read -r -d '' PYTHON_PARSE << 'PYEOF'
import sys, json, re, os
from datetime import datetime, timezone

db_path    = sys.argv[1]
queue_path = sys.argv[2] if len(sys.argv) > 2 else None

# Build slurm_jobid → task map for running hive tasks
jobid_to_task = {}
if queue_path:
    try:
        with open(queue_path) as _qf:
            _q = json.load(_qf)
        for _t in _q.get("tasks", {}).values():
            if _t.get("state") == "running" and _t.get("slurm_jobid"):
                jobid_to_task[str(_t["slurm_jobid"])] = _t
    except Exception:
        pass
try:
    with open(db_path) as f:
        data = json.load(f)
except Exception as e:
    print(f"ERROR\t{e}")
    sys.exit(1)

updated = data.get("updated", "")
print(f"UPDATED\t{updated}")

try:
    ts = datetime.fromisoformat(updated)
    if ts.tzinfo is None:
        ts = ts.replace(tzinfo=timezone.utc)
    now = datetime.now(timezone.utc)
    diff = int((now - ts).total_seconds())
    if diff > 600:
        print(f"STALE\t{diff}")
except Exception:
    pass

def mem_gb(mib):
    return f"{round(int(mib) / 1024)}G"

def is_job_stale(polled_at):
    try:
        pts = datetime.fromisoformat(polled_at)
        if pts.tzinfo is None:
            pts = pts.replace(tzinfo=timezone.utc)
        now = datetime.now(timezone.utc)
        return (now - pts).total_seconds() > 600
    except Exception:
        return False

def _updated_age():
    try:
        ts = datetime.fromisoformat(updated)
        if ts.tzinfo is None:
            ts = ts.replace(tzinfo=timezone.utc)
        return max(0, int((datetime.now(timezone.utc) - ts).total_seconds()))
    except Exception:
        return 0

UPD_AGE = _updated_age()

def fmt_left(secs):
    # Remaining hold-job walltime; time_left_secs was captured at `updated`, so we
    # subtract the DB's age. None (older poller) → "—"; -1 → unlimited.
    if secs is None:
        return "—"
    try:
        secs = int(secs)
    except Exception:
        return "—"
    if secs < 0:
        return "inf"
    secs = max(0, secs - UPD_AGE)
    d, r = divmod(secs, 86400)
    h, r = divmod(r, 3600)
    m, _ = divmod(r, 60)
    if d:
        return f"{d}d{h}h"
    if h:
        return f"{h}h{m}m"
    return f"{m}m"

jobs = data.get("jobs", {})
for jobid in sorted(jobs.keys(), key=lambda x: int(x) if x.isdigit() else 0):
    j = jobs[jobid]
    node     = j.get("node", "")
    part     = j.get("partition", "")
    elapsed  = j.get("job_elapsed", "")
    status   = j.get("status", "idle")
    polled_at= j.get("polled_at", "")

    gpus = j.get("gpu", [])
    if gpus:
        g = gpus[0]
        gpu_util  = int(g.get("util",  0))
        mem_used  = int(g.get("mem_used",  0))
        mem_total = int(g.get("mem_total", 0))
    else:
        gpu_util = mem_used = mem_total = 0

    mem_str = f"{mem_gb(mem_used)}/{mem_gb(mem_total)}"

    procs = j.get("processes", [])
    task_cmd = ""
    if procs:
        best = max(procs, key=lambda p: float(p.get("cpu", 0)))
        raw_cmd = best.get("cmd", "")
        m = re.search(r"(python\S*\s.+|bash\s.+)", raw_cmd)
        task_cmd = m.group(1).strip() if m else raw_cmd.strip()

    # Override with authoritative queue data if a hive task owns this job
    qt = jobid_to_task.get(jobid)
    if qt:
        tid    = qt["id"]
        name   = qt.get("name") or ""
        qcmd   = qt.get("cmd", "").replace("\n", " ").strip()
        prefix = f"#{tid} {name}: " if name else f"#{tid}: "
        task_cmd = prefix + qcmd

    if len(task_cmd) > 55:
        task_cmd = task_cmd[:54] + "…"

    stale_flag = "1" if is_job_stale(polled_at) else "0"
    left = fmt_left(j.get("time_left_secs"))

    # task_cmd MUST be last: bash IFS=$'\t' read collapses consecutive tabs
    # (tab is IFS whitespace), so an empty task_cmd field would be swallowed.
    # Putting it last lets the final read variable capture "" correctly.
    fields = "\t".join([jobid, node, part, elapsed, status,
                        str(gpu_util), mem_str, left, stale_flag, task_cmd])
    print(f"JOB\t{fields}")
PYEOF

# ── display helpers ───────────────────────────────────────────────────────────
print_col() {
    local color="$1" text="$2" width="$3" sep="${4:-  }"
    local len="${#text}"
    local pad=$(( width - len ))
    (( pad < 0 )) && pad=0
    printf "${color}%s${NC}%*s%s" "$text" "$pad" "" "$sep"
}

show_table() {
    if [[ ! -f "$DB_FILE" ]]; then
        echo ""
        printf "  ${RED}DB not found: %s${NC}\n" "$DB_FILE"
        printf "  Run  ${BOLD}hive nodes poll${NC}  to poll once, or  ${BOLD}hive daemon start${NC}  to start the daemon.\n\n"
        return 1
    fi

    local parsed
    _PY="${HIVE_PYTHON:-}"
    [[ -z "$_PY" && -x "${HOME}/.conda/envs/vlm/bin/python3" ]] && _PY="${HOME}/.conda/envs/vlm/bin/python3"
    [[ -z "$_PY" ]] && _PY="$(command -v python3 2>/dev/null)"
    parsed=$("$_PY" - "$DB_FILE" "$QUEUE_FILE" <<< "$PYTHON_PARSE" 2>/dev/null)
    if [[ -z "$parsed" ]]; then
        echo -e "\n  ${RED}Failed to parse DB (is python3 available?).${NC}\n"
        return 1
    fi

    local updated="" is_stale=0
    local -a rows=()

    while IFS=$'\t' read -r rectype rest; do
        case "$rectype" in
            UPDATED) updated="$rest" ;;
            STALE)   is_stale=1 ;;
            JOB)     rows+=("$rest") ;;
            ERROR)
                echo ""
                printf "  ${RED}Parse error: %s${NC}\n\n" "$rest"
                return 1
                ;;
        esac
    done <<< "$parsed"

    echo ""
    if (( is_stale )); then
        printf "  ${BOLD}[last polled: ${RED}%s  <-- stale data (>10 min ago)${NC}${BOLD}]${NC}\n" "$updated"
    else
        printf "  ${BOLD}[last polled: %s]${NC}\n" "$updated"
    fi
    echo ""

    local SEP
    SEP=$(printf '%0.s─' {1..91})

    printf "  "
    print_col "$BOLD" "JOBID"   10
    print_col "$BOLD" "NODE"    8
    print_col "$BOLD" "PART"    9
    print_col "$BOLD" "ELAPSED" 10
    print_col "$BOLD" "STATUS"  6
    print_col "$BOLD" "GPU%"    5
    print_col "$BOLD" "MEM"     9
    print_col "$BOLD" "LEFT"    8
    print_col "$BOLD" "TASK"    0 ""
    printf "${NC}\n"
    printf "  %s\n" "$SEP"

    local n_busy=0 n_cpu=0 n_idle=0 n_pfail=0

    for row in "${rows[@]}"; do
        IFS=$'\t' read -r jobid node part elapsed status gpu_util mem_str left job_stale task_cmd <<< "$row"

        local status_upper status_color
        if [[ "$status" == "busy" ]]; then
            status_upper="BUSY";    status_color="${GREEN}${BOLD}"
            n_busy=$(( n_busy + 1 ))
        elif [[ "$status" == "cpu" ]]; then
            status_upper="CPU  ";   status_color="${CYAN}${BOLD}"
            n_cpu=$(( n_cpu + 1 ))
        elif [[ "$status" == "warning" ]]; then
            status_upper="WARN ";   status_color="${YELLOW}${BOLD}"
            n_busy=$(( n_busy + 1 ))
        elif [[ "$status" == "probe_failed" || "$status" == "unknown" ]]; then
            # Probe could not run — NOT idle. Counted separately so the summary
            # doesn't conflate "GPU free" with "we couldn't tell" (feedback OPT-J).
            status_upper="PFAIL";   status_color="${RED}${DIM}"
            n_pfail=$(( n_pfail + 1 ))
        else
            status_upper="IDLE";    status_color="${YELLOW}${DIM}"
            n_idle=$(( n_idle + 1 ))
        fi

        local gpu_int gpu_disp gpu_color
        gpu_int=$(printf '%.0f' "${gpu_util:-0}" 2>/dev/null || echo 0)
        gpu_disp="${gpu_util}%"
        if (( gpu_int > 50 )); then
            gpu_color="$GREEN"
        elif (( gpu_int > 0 )); then
            gpu_color="$YELLOW"
        else
            gpu_color="$DIM"
        fi

        local node_text="$node"
        (( job_stale )) && node_text="${node}!"

        local task_text task_color
        if [[ "$status" == "busy" && -n "$task_cmd" ]]; then
            task_text="$task_cmd"; task_color=""
        else
            task_text="—"; task_color="$DIM"
        fi

        printf "  "
        print_col ""             "$jobid"       10
        if (( job_stale )); then
            printf "%s${RED}!${NC}%*s  " "$node" "$(( 8 - ${#node} - 1 ))" ""
        else
            print_col "" "$node" 8
        fi
        print_col ""             "$part"        9
        print_col ""             "$elapsed"     10
        print_col "$status_color" "$status_upper" 6
        print_col "$gpu_color"   "$gpu_disp"    5
        print_col ""             "$mem_str"     9
        # Warn-color the remaining walltime when a node is close to expiry.
        local left_color=""
        case "$left" in
            —|inf) left_color="$DIM" ;;
            *m)    [[ "$left" != *h* && "$left" != *d* ]] && left_color="$RED" ;;
        esac
        print_col "$left_color"  "$left"        8
        print_col "$task_color"  "$task_text"   0 ""
        echo ""
    done

    printf "  %s\n" "$SEP"
    local summary
    summary=$(printf "  ${BOLD}busy: ${GREEN}%d${NC}${BOLD}   cpu: ${CYAN}%d${NC}${BOLD}   idle: ${YELLOW}%d${NC}" \
        "$n_busy" "$n_cpu" "$n_idle")
    (( n_pfail > 0 )) && summary+="$(printf "${BOLD}   probe-fail: ${RED}%d${NC}" "$n_pfail")"
    summary+="$(printf "${BOLD}   total: %d${NC}" "$(( n_busy + n_cpu + n_idle + n_pfail ))")"
    printf "%s\n" "$summary"
}

# ── subcommand: status ────────────────────────────────────────────────────────
cmd_status() {
    echo ""
    if daemon_running; then
        local pid host; pid=$(daemon_pid); host=$(daemon_host)
        local start_time uptime_str="" elapsed_secs=""
        # ps only works on the host the daemon actually runs on.
        if [[ -z "$host" || "$host" == "$(hostname)" ]]; then
            start_time=$(ps -o lstart= -p "$pid" 2>/dev/null | xargs -I{} date -d "{}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)
            elapsed_secs=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ' || echo "")
        fi
        if [[ -n "$elapsed_secs" && "$elapsed_secs" =~ ^[0-9]+$ ]]; then
            local d=$(( elapsed_secs / 86400 ))
            local h=$(( (elapsed_secs % 86400) / 3600 ))
            local m=$(( (elapsed_secs % 3600) / 60 ))
            if (( d > 0 )); then
                uptime_str="${d}d ${h}h ${m}m"
            elif (( h > 0 )); then
                uptime_str="${h}h ${m}m"
            else
                uptime_str="${m}m"
            fi
        fi

        local last_poll=""
        if [[ -f "$LOG_FILE" ]]; then
            last_poll=$(grep "DB written" "$LOG_FILE" 2>/dev/null | tail -1 | grep -oP '^\[\K[^\]]+' || true)
        fi

        printf "  ${BOLD}daemon:${NC}     ${GREEN}RUNNING${NC}\n"
        printf "  ${BOLD}PID:${NC}        %s\n" "$pid"
        [[ -n "$host" ]] && printf "  ${BOLD}host:${NC}       %s\n" "$host"
        [[ -n "$start_time" ]] && printf "  ${BOLD}started:${NC}    %s\n" "$start_time"
        [[ -n "$uptime_str" ]] && printf "  ${BOLD}uptime:${NC}     %s\n" "$uptime_str"
        [[ -n "$last_poll" ]] && printf "  ${BOLD}last poll:${NC}  %s\n" "$last_poll"
        printf "  ${BOLD}log:${NC}        %s\n" "$LOG_FILE"
        printf "  ${BOLD}db:${NC}         %s\n" "$DB_FILE"
    else
        printf "  ${BOLD}daemon:${NC}     ${RED}STOPPED${NC}\n"
        printf "  Run  ${BOLD}hive daemon start${NC}  to start the daemon.\n"
    fi
    echo ""
}

# ── usage ─────────────────────────────────────────────────────────────────────
usage() {
    cat << EOF
Usage: hive nodes [command | option]

Commands:
  (no args)    Show node table (auto-starts daemon if not running)
  start        Start daemon
  stop         Stop daemon
  restart      Restart daemon
  status       Show daemon PID / uptime / last poll time
  logs         Tail last 40 lines of daemon log
  poll         Run one immediate poll now

Options:
  -h, --help   Show this help

For continuous interactive monitoring use: hive top
EOF
}

# ── entry point ───────────────────────────────────────────────────────────────
case "${1:-}" in
    start)
        daemon_start
        exit 0
        ;;
    stop)
        daemon_stop
        exit 0
        ;;
    restart)
        daemon_stop
        sleep 1
        daemon_start
        exit 0
        ;;
    status)
        cmd_status
        exit 0
        ;;
    logs)
        if [[ -f "$LOG_FILE" ]]; then
            tail -n 40 "$LOG_FILE"
        else
            echo -e "  ${DIM}No log file found: $LOG_FILE${NC}"
        fi
        exit 0
        ;;
    poll)
        echo -e "${DIM}Running one-shot poll...${NC}"
        "$POLL_BIN"
        echo ""
        show_table
        show_daemon_footer
        exit 0
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    "")
        # default: show once
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac

# ── default: show once ────────────────────────────────────────────────────────
if ! daemon_running; then
    daemon_start
    sleep 1
fi
show_table
show_daemon_footer
