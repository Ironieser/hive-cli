#!/usr/bin/env bash
# hive-poll — one-shot poller for hive-cli
# DB: ~/.hive/node_monitor.json
# Safe to run via cron every 5 minutes.

USER="${USER:-$(whoami)}"
HIVE_DIR="${HIVE_DIR:-${HOME}/.hive}"
DB_DIR="$HIVE_DIR"
DB_FILE="${HIVE_DIR}/node_monitor.json"
DB_TMP="${DB_FILE}.$$.tmp"          # PID-scoped so concurrent writers don't clobber (feedback OPT-C)
DB_LOCK="${DB_FILE}.lock"
POLL_TMPDIR="/tmp/hive_poll_$$"
_LIBEXEC="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
DBPOST_BIN="${_LIBEXEC}/hive-dbpost"

# ── helpers ──────────────────────────────────────────────────────────────────

log() { echo "[$(date '+%H:%M:%S')] $*"; }

fmt_elapsed_slurm() {
    # Input: SLURM elapsed  [D-]HH:MM:SS or M:SS
    local t="$1"
    local days=0 hours=0 mins=0 secs=0
    if [[ "$t" == *-* ]]; then
        days="${t%%-*}"; t="${t#*-}"
    fi
    IFS=':' read -ra p <<< "$t"
    if (( ${#p[@]} == 3 )); then
        hours=$(( 10#${p[0]} )); mins=$(( 10#${p[1]} )); secs=$(( 10#${p[2]} ))
    elif (( ${#p[@]} == 2 )); then
        mins=$(( 10#${p[0]} )); secs=$(( 10#${p[1]} ))
    fi
    days=$(( 10#$days ))
    if (( days > 0 )); then
        printf "%dd%dh" "$days" "$hours"
    elif (( hours > 0 )); then
        printf "%dh%dm" "$hours" "$mins"
    else
        printf "%dm" "$mins"
    fi
}

fmt_elapsed_ps() {
    # Input: ps etime format  [[dd-]hh:]mm:ss
    local t="$1"
    local days=0 hours=0 mins=0 secs=0
    if [[ "$t" == *-* ]]; then
        days="${t%%-*}"; t="${t#*-}"
    fi
    IFS=':' read -ra p <<< "$t"
    if (( ${#p[@]} == 3 )); then
        hours=$(( 10#${p[0]} )); mins=$(( 10#${p[1]} )); secs=$(( 10#${p[2]} ))
    elif (( ${#p[@]} == 2 )); then
        mins=$(( 10#${p[0]} )); secs=$(( 10#${p[1]} ))
    fi
    days=$(( 10#$days ))
    if (( days > 0 )); then
        printf "%dd%dh" "$days" "$hours"
    elif (( hours > 0 )); then
        printf "%dh%dm" "$hours" "$mins"
    else
        printf "%dm" "$mins"
    fi
}

json_escape() {
    # Minimal JSON string escaping: backslash, double-quote, control chars
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

slurm_time_to_secs() {
    # SLURM TimeLeft (%L): [D-]HH:MM:SS / HH:MM:SS / MM:SS / UNLIMITED / N/A.
    # Emits a JSON token (no quotes): integer seconds, -1 for UNLIMITED, or null.
    local t="$1"
    case "$t" in
        UNLIMITED|unlimited|INFINITE|infinite) printf '%s' '-1'; return ;;
        ''|N/A|n/a|INVALID|NOT_SET)           printf 'null';     return ;;
    esac
    local days=0
    if [[ "$t" == *-* ]]; then days="${t%%-*}"; t="${t#*-}"; fi
    local IFS=':'; local -a p; read -ra p <<< "$t"
    local h=0 m=0 s=0
    if (( ${#p[@]} == 3 )); then
        h=$(( 10#${p[0]:-0} )); m=$(( 10#${p[1]:-0} )); s=$(( 10#${p[2]:-0} ))
    elif (( ${#p[@]} == 2 )); then
        m=$(( 10#${p[0]:-0} )); s=$(( 10#${p[1]:-0} ))
    elif (( ${#p[@]} == 1 )); then
        s=$(( 10#${p[0]:-0} ))
    else
        printf 'null'; return
    fi
    days=$(( 10#${days:-0} ))
    printf '%s' "$(( days*86400 + h*3600 + m*60 + s ))"
}

# ── probe a single job (runs in background subshell) ─────────────────────────
probe_job() {
    local jobid="$1" node="$2" partition="$3" elapsed_raw="$4" time_left_secs="${5:-null}"
    local outfile="${POLL_TMPDIR}/${jobid}.json"
    local polled_at
    polled_at=$(date -u '+%Y-%m-%dT%H:%M:%S')
    local elapsed_fmt
    elapsed_fmt=$(fmt_elapsed_slurm "$elapsed_raw")

    # Probe command: nvidia-smi via srun --overlap.
    #
    # GPU stats (utilization/memory) enumerate ALL the job's GPUs (no --id=0). SLURM
    # cgroup device isolation (set at job allocation time) already scopes nvidia-smi to
    # this job's GPUs, renumbered 0..N-1 — so this returns exactly the job's own cards:
    # one line for a 1-GPU job (unchanged), N lines for a multi-GPU job. The status logic
    # below takes the max across them (busy if ANY GPU is busy).
    #
    # Process filtering uses /proc/<pid>/cgroup to check job ownership.
    # CUDA_VISIBLE_DEVICES is unreliable under concurrent srun --overlap steps (multiple
    # parallel probes on the same node corrupt each other's GPU index mappings), so
    # --query-compute-apps can return PIDs from other jobs' GPUs. The fix: after getting
    # PIDs from compute-apps, verify each PID's /proc/<pid>/cgroup contains
    # /job_<SLURM_JOB_ID>/ — this is set by the kernel at job allocation and is immune
    # to concurrent step launches. compute-apps is deduped by PID (sort -u on the pid
    # field) so a process spanning >1 GPU is listed once.
    #
    # KEEP IN SYNC with hive-daemon's probe_cmd (the probe body is intentionally duplicated).
    #
    # The GPU query runs in the background under a 60 s deadline (120 half-second ticks — a
    # healthy node was measured at 24 s, wedged ones at 116 s+;
    # HIVE_GPU_QUERY_TICKS overrides it for the offline tests) and reports
    # `GPU_PROBE hung` when the driver never answers (a wedged node blocks nvidia-smi
    # in uninterruptible sleep, so `timeout` cannot end it) — see gpu_query_shell in
    # hive_health.py, which is the scheduler's copy of this. `GPU_PROBE granted=` is
    # the step's CUDA_VISIBLE_DEVICES: non-empty means SLURM gave this job a GPU.
    local probe_cmd
    probe_cmd='MY_JOB=$SLURM_JOB_ID; echo "GPU_PROBE granted=${CUDA_VISIBLE_DEVICES:-}"; _o=; for _d in "${TMPDIR:-}" /tmp /dev/shm; do [ -n "$_d" ] && [ -d "$_d" ] || continue; _t=$(mktemp -p "$_d" hive_probe.XXXXXXXX 2>/dev/null) || continue; if echo x >"$_t" 2>/dev/null && echo x >"$_t.rc" 2>/dev/null; then : >"$_t"; rm -f "$_t.rc"; _o=$_t; break; fi; rm -f "$_t" "$_t.rc"; done; [ -n "$_o" ] || { echo "GPU_PROBE nowrite"; exit 0; }; ( nvidia-smi --query-gpu=index,utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits >"$_o" 2>/dev/null; echo $? >"$_o.rc" ) </dev/null >/dev/null 2>&1 & _i=0; while [ ! -s "$_o.rc" ] && [ "$_i" -lt "${HIVE_GPU_QUERY_TICKS:-120}" ]; do sleep 0.5; _i=$((_i+1)); done; _H=; if [ -s "$_o.rc" ]; then cat "$_o"; else _H=1; echo "GPU_PROBE hung"; fi; rm -f "$_o" "$_o.rc"; echo "---PS---"; [ -n "$_H" ] || nvidia-smi --query-compute-apps=pid,used_gpu_memory --format=csv,noheader,nounits 2>/dev/null | sort -t, -k1,1 -u | while IFS=, read apid amem; do apid="${apid// /}"; amem="${amem// /}"; [[ -z "$apid" || ! "$apid" =~ ^[0-9]+$ ]] && continue; grep -q "/job_${MY_JOB}/" /proc/${apid}/cgroup 2>/dev/null || continue; etime=$(ps -p "$apid" -o etime --no-header 2>/dev/null | tr -d " "); args=$(ps -p "$apid" -o args --no-header 2>/dev/null); echo "$apid 0.0 0.0 ${etime:-0:00} $args"; done'

    # Run the probe; retry once on a transient failure (empty output, non-zero
    # exit, or missing ---PS--- marker = srun never executed our command). This
    # distinguishes "probe failed" from "GPU genuinely idle" (feedback OPT-A).
    local raw rc
    raw=$(timeout 150 srun --jobid="$jobid" --overlap -n1 --mem=0 \
        bash -c "$probe_cmd" 2>/dev/null); rc=$?
    if [[ "$raw" != *"GPU_PROBE hung"* && "$raw" != *"GPU_PROBE nowrite"* ]] \
            && [[ $rc -ne 0 || -z "$raw" || "$raw" != *"---PS---"* ]]; then
        sleep 1
        raw=$(timeout 150 srun --jobid="$jobid" --overlap -n1 --mem=0 \
            bash -c "$probe_cmd" 2>/dev/null); rc=$?
    fi
    # probe_detail says WHY a probe failed: gpu_unresponsive / no_gpu_devices are the
    # node's fault (the scheduler strikes it on verify), srun_failed is the step's.
    local probe_failed=0 probe_detail="" gpu_granted=""
    if [[ "$raw" == *"GPU_PROBE nowrite"* ]]; then
        # No writable temp dir on the node: the probe could not run. Not a verdict.
        probe_failed=1; probe_detail="srun_failed"
    elif [[ "$raw" == *"GPU_PROBE hung"* ]]; then
        probe_failed=1; probe_detail="gpu_unresponsive"
    elif [[ $rc -ne 0 || -z "$raw" || "$raw" != *"---PS---"* ]]; then
        probe_failed=1; probe_detail="srun_failed"
    fi
    [[ "$raw" =~ GPU_PROBE\ granted=([^[:space:]]+) ]] && gpu_granted="${BASH_REMATCH[1]}"

    # ── parse both sections in one pass ──────────────────────────────────────
    local in_ps=0
    local gpu_json="" ps_json=""
    local first_gpu=1 first_ps=1
    local has_process=0
    local max_gpu_mem=0 max_gpu_util=0 max_gpu_total=0
    # Skip noisy ps entries
    local skip_re='sleep|slurm_script|bash|sh |srun|ps -u|grep|nvidia-smi|tmux|zsh|fish|-bash|-zsh|-fish'

    while IFS= read -r line; do
        if [[ "$line" == "---PS---" ]]; then
            in_ps=1; continue
        fi

        if (( in_ps == 0 )); then
            # ── nvidia-smi line ───────────────────────────────────────────────
            [[ -z "$line" ]] && continue
            IFS=',' read -r gidx gutil gmem_used gmem_total <<< "$line"
            gidx="${gidx// /}"; gutil="${gutil// /}"
            gmem_used="${gmem_used// /}"; gmem_total="${gmem_total// /}"
            # Skip lines where index is not a plain number (e.g. "No devices were found")
            [[ -z "$gidx" || ! "$gidx" =~ ^[0-9]+$ ]] && continue
            [[ "$first_gpu" -eq 0 ]] && gpu_json+=","
            gpu_json+="{\"index\":${gidx},\"util\":${gutil:-0},\"mem_used\":${gmem_used:-0},\"mem_total\":${gmem_total:-0}}"
            first_gpu=0
            (( ${gmem_used:-0}  > max_gpu_mem   )) && max_gpu_mem=${gmem_used:-0}
            (( ${gutil:-0}     > max_gpu_util  )) && max_gpu_util=${gutil:-0}
            (( ${gmem_total:-0} > max_gpu_total )) && max_gpu_total=${gmem_total:-0}

        else
            # ── ps line ───────────────────────────────────────────────────────
            [[ -z "$line" ]] && continue
            # Filter noisy processes
            echo "$line" | grep -qE "$skip_re" && continue

            # Fields: pid %cpu %mem etime args...
            local fields ppid pcpu pmem petime pcmd
            read -ra fields <<< "$line"
            ppid="${fields[0]}"; pcpu="${fields[1]}"; pmem="${fields[2]}"; petime="${fields[3]}"
            pcmd="${fields[*]:4}"

            [[ -z "$ppid" || -z "$pcmd" ]] && continue
            [[ ! "$ppid" =~ ^[0-9]+$ ]] && continue

            local elapsed_ps cmd_esc
            elapsed_ps=$(fmt_elapsed_ps "$petime")
            cmd_esc=$(json_escape "$pcmd")

            [[ "$first_ps" -eq 0 ]] && ps_json+=","
            ps_json+="{\"pid\":${ppid},\"cpu\":${pcpu:-0},\"mem\":${pmem:-0},\"elapsed\":\"${elapsed_ps}\",\"cmd\":\"${cmd_esc}\"}"
            first_ps=0
            has_process=1
        fi
    done <<< "$raw"

    # status (raw — Python post-processing in main() resolves warning transitions):
    #   cpu     — job has no GPU allocated (mem_total=0 for all GPUs)
    #   idle    — GPU allocated but not active (util<5% AND mem<500MB)
    #   busy    — GPU actively used (util≥5% or mem≥500MB)
    #
    # NOTE: ps output is node-wide (not cgroup-scoped), so has_process is
    # unreliable on multi-GPU nodes with multiple hold jobs — DO NOT use it
    # for status. GPU data from nvidia-smi is reliable (CUDA_VISIBLE_DEVICES
    # is properly scoped per job by SLURM). processes[] is kept for display only.
    #   probe_failed — the srun --overlap probe could not be run (NOT idle/cpu).
    #                   hive-dbpost may carry forward the last-good state.
    local status
    if (( probe_failed )); then
        status="probe_failed"
    elif (( max_gpu_total == 0 )) && [[ -n "$gpu_granted" ]]; then
        # SLURM granted a GPU but nvidia-smi listed none ("No devices were found"):
        # a broken node, not a CPU-only hold job.
        status="probe_failed"; probe_detail="no_gpu_devices"
    elif (( max_gpu_total == 0 )); then
        status="cpu"
    elif (( max_gpu_util >= 5 || max_gpu_mem >= 500 )); then
        status="busy"
    else
        status="idle"
    fi

    # Write per-job JSON fragment (assembled by main)
    # gpu_idle_since is a placeholder (null); Python post-processing fills it in
    cat > "$outfile" <<EOF
"${jobid}": {
  "node": "$(json_escape "$node")",
  "partition": "$(json_escape "$partition")",
  "job_elapsed": "$(json_escape "$elapsed_fmt")",
  "gpu": [${gpu_json}],
  "processes": [${ps_json}],
  "status": "${status}",
  "probe_detail": "${probe_detail}",
  "gpu_idle_since": null,
  "time_left_secs": ${time_left_secs},
  "polled_at": "${polled_at}"
}
EOF
}

# ── main ──────────────────────────────────────────────────────────────────────
main() {
    log "hive-poll starting"

    # Ensure cache dir
    mkdir -p "$DB_DIR"
    mkdir -p "$POLL_TMPDIR"

    # Serialize writers to node_monitor.json (feedback OPT-C). If another poll /
    # the daemon already holds the lock, a second concurrent poll is redundant —
    # exit immediately rather than racing on the final mv.
    exec 9>"$DB_LOCK"
    if ! flock -n 9; then
        log "Another poll is already in progress — exiting."
        rm -rf "$POLL_TMPDIR"
        return
    fi

    # Query running jobs. %L = TimeLeft (remaining walltime) so the scheduler can
    # avoid placing long tasks on a soon-expiring node. %j (job name, last col) is
    # only there so cursor_ssh_proxy can be filtered — the old format had no name
    # column, so the grep never matched and `hive poll` wrote one more job than the
    # daemon did. KEEP IN SYNC with hive-daemon.
    local squeue_out
    squeue_out=$(squeue -u "$USER" -t R --noheader -o "%i|%N|%P|%M|%L|%j" 2>/dev/null \
        | grep -vE '\|(cursor_ssh_proxy|hive_canary)$' \
        | sed 's/|[^|]*$//')   # strip job name column after filtering

    if [[ -z "$squeue_out" ]]; then
        log "No running jobs found."
        local updated
        updated=$(date -u '+%Y-%m-%dT%H:%M:%S')
        printf '{\n  "updated": "%s",\n  "jobs": {}\n}\n' "$updated" > "$DB_TMP"
        mv "$DB_TMP" "$DB_FILE"
        rm -rf "$POLL_TMPDIR"
        log "DB written (empty): $DB_FILE"
        return
    fi

    # Launch parallel probes
    local job_ids=()
    declare -A JOB_NODE JOB_PART JOB_ELAPSED JOB_TIMELEFT

    # Read squeue into an array first, and give each background probe </dev/null:
    # a backgrounded srun inherits the while-read loop's stdin and can swallow the
    # remaining lines (same guard as hive-daemon).
    local -a squeue_lines=()
    while IFS= read -r line; do
        squeue_lines+=("$line")
    done <<< "$squeue_out"

    for line in "${squeue_lines[@]}"; do
        IFS='|' read -r jobid node partition elapsed timeleft <<< "$line"
        jobid="${jobid// /}"; node="${node// /}"
        partition="${partition// /}"; elapsed="${elapsed// /}"; timeleft="${timeleft// /}"
        [[ -z "$jobid" || -z "$node" || "$node" == "N/A" ]] && continue
        job_ids+=("$jobid")
        JOB_NODE["$jobid"]="$node"
        JOB_PART["$jobid"]="$partition"
        JOB_ELAPSED["$jobid"]="$elapsed"
        JOB_TIMELEFT["$jobid"]="$(slurm_time_to_secs "$timeleft")"
        log "Probing job $jobid on $node ($partition) elapsed=$elapsed left=${timeleft:-?} ..."
        probe_job "$jobid" "$node" "$partition" "$elapsed" "${JOB_TIMELEFT[$jobid]}" </dev/null &
    done

    # Wait up to 30s for all probes
    local waited=0
    while true; do
        local pending=0
        for jid in "${job_ids[@]}"; do
            [[ ! -f "${POLL_TMPDIR}/${jid}.json" ]] && pending=1 && break
        done
        (( pending == 0 )) && break
        sleep 1
        waited=$(( waited + 1 ))
        (( waited >= 30 )) && log "WARNING: timeout waiting for probes after ${waited}s" && break
    done
    wait   # reap any remaining

    log "All probes complete (waited ${waited}s). Building DB..."

    # Assemble final JSON
    local updated
    updated=$(date -u '+%Y-%m-%dT%H:%M:%S')

    {
        printf '{\n  "updated": "%s",\n  "jobs": {\n' "$updated"
        local first=1
        for jid in "${job_ids[@]}"; do
            local frag="${POLL_TMPDIR}/${jid}.json"
            # probe subshell was reaped before writing — emit an explicit
            # probe_failed fallback instead of silently dropping the node
            # (feedback OPT-A: a missing node is invisible to the scheduler).
            if [[ ! -f "$frag" ]]; then
                local fb_polled; fb_polled=$(date -u '+%Y-%m-%dT%H:%M:%S')
                local fb_elapsed; fb_elapsed=$(fmt_elapsed_slurm "${JOB_ELAPSED[$jid]:-0:00}")
                cat > "$frag" <<FBEOF
"${jid}": {
  "node": "$(json_escape "${JOB_NODE[$jid]}")",
  "partition": "$(json_escape "${JOB_PART[$jid]}")",
  "job_elapsed": "$(json_escape "$fb_elapsed")",
  "gpu": [],
  "processes": [],
  "status": "probe_failed",
  "gpu_idle_since": null,
  "time_left_secs": ${JOB_TIMELEFT[$jid]:-null},
  "polled_at": "${fb_polled}"
}
FBEOF
            fi
            (( first == 0 )) && printf ',\n'
            # Each fragment line gets 4-space indent
            while IFS= read -r fline; do
                printf '    %s\n' "$fline"
            done < "$frag"
            first=0
        done
        printf '  }\n}\n'
    } > "$DB_TMP"

    # Save old DB for gpu_idle_since timer before overwriting
    local OLD_DB_CONTENT_FILE="${POLL_TMPDIR}/old_db.json"
    [[ -f "$DB_FILE" ]] && cp "$DB_FILE" "$OLD_DB_CONTENT_FILE" || touch "$OLD_DB_CONTENT_FILE"

    mv "$DB_TMP" "$DB_FILE"

    # Post-process: busy→idle warning grace timer + carry-forward of last-good
    # state for probe_failed jobs. Shared with hive-daemon via hive-dbpost so the
    # two pollers can't drift apart (feedback OPT-A).
    if [[ -x "$DBPOST_BIN" ]]; then
        python3 "$DBPOST_BIN" "$DB_FILE" "$OLD_DB_CONTENT_FILE" 2>/dev/null || true
    fi

    rm -rf "$POLL_TMPDIR"
    log "DB written: $DB_FILE  (${#job_ids[@]} jobs)"
}

main "$@"

# ── cron hint ─────────────────────────────────────────────────────────────────
# To auto-poll every 5 minutes, add to crontab:
# */5 * * * * /home/si384883/hive-cli/libexec/hive-poll >> /home/si384883/.hive/node_monitor.log 2>&1
